  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>273836</PointerOffset>
      <JapaneseText>おおぉ、ワシの
可愛い猫ちゃんや……</JapaneseText>
      <EnglishText>Ooh, my lovely
little kitty...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273836</PointerOffset>
      <JapaneseText>お嬢ちゃんや、
ありがとうよ</JapaneseText>
      <EnglishText>Thank you,
young lady.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273884</PointerOffset>
      <JapaneseText>いえ、そんな</JapaneseText>
      <EnglishText>No, it's fine!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273968</PointerOffset>
      <JapaneseText>おおっ、
他の猫ちゃんたちも
戻ってきたぞ</JapaneseText>
      <EnglishText>Ohh, the others have
come back, too...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274016</PointerOffset>
      <JapaneseText>ニャーン∀</JapaneseText>
      <EnglishText>Nya~n</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274060</PointerOffset>
      <JapaneseText>ニャーン♪</JapaneseText>
      <EnglishText>Nya~n</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274184</PointerOffset>
      <JapaneseText>おお。
ワシ以外にはなつかない
シマコがぁ……</JapaneseText>
      <EnglishText>Ooh, that's little Shimako...
She never takes to anyone
but me, and yet...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274184</PointerOffset>
      <JapaneseText>お嬢ちゃんも相当の
猫好きと見た！</JapaneseText>
      <EnglishText>She can see you're
a true cat-lover, too!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274236</PointerOffset>
      <JapaneseText>ええ、じ、実は……</JapaneseText>
      <EnglishText>Yes, th-the truth is...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274296</PointerOffset>
      <JapaneseText>え！　そ、そうなのかぁ！？</JapaneseText>
      <EnglishText>Eh!? I-Is that true!? Really!?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274372</PointerOffset>
      <JapaneseText>いや……
今まで見てて
わからなかった……？</JapaneseText>
      <EnglishText>I mean... Couldn't
you already kind
of tell by now...?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274448</PointerOffset>
      <JapaneseText>……あ、うん、
わかってっけど、一応……</JapaneseText>
      <EnglishText>...Uh, well, yeah, I
could, more or less, but...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>12</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274552</PointerOffset>
      <JapaneseText>ワシの
キングオブ“ねこ”ラバーを
お嬢ちゃんに譲ってよいぞ？</JapaneseText>
      <EnglishText>Mightn't I bequeath my
"King of Cat Lovers"
position to you, young lady?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>13</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274620</PointerOffset>
      <JapaneseText>キングオブ……
それって何ですか？</JapaneseText>
      <EnglishText>"King of"... Um,
what is it, exactly?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>14</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274708</PointerOffset>
      <JapaneseText>喋る時に『にゃ』をつけて
喋ってよいのニャ！</JapaneseText>
      <EnglishText>You just have to say "nya"
whenever you speak.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>15</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274752</PointerOffset>
      <JapaneseText>ください！</JapaneseText>
      <EnglishText>Oh, I'd love to!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>16</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274812</PointerOffset>
      <JapaneseText>ほしいのか……
それ……</JapaneseText>
      <EnglishText>Uh, do you really...
want to do that...?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>17</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274992</PointerOffset>
      <JapaneseText>それじゃあ、
おじいさん、さよなら</JapaneseText>
      <EnglishText>Well, then, I bid
you adieu, sir!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>18</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274992</PointerOffset>
      <JapaneseText>あっ……
さようならニャ！</JapaneseText>
      <EnglishText>Oh, wait... I bid
you adieu, nya!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>18</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275044</PointerOffset>
      <JapaneseText>言い直すなよ……</JapaneseText>
      <EnglishText>C'mon, don't "correct"
yourself like that...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>20</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275132</PointerOffset>
      <JapaneseText>ね、&lt;Mel&gt;……
それ普段やめてね。
ちょっと、ヘン……</JapaneseText>
      <EnglishText>Hey, &lt;Mel&gt;... Please
don't say that all the time,
okay? It's...um, weird...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>21</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275204</PointerOffset>
      <JapaneseText>ご、ごめん、
じゃあ戦う時だけにするね</JapaneseText>
      <EnglishText>S-Sorry. Then, I'll
just say it in battles!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>22</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275328</PointerOffset>
      <JapaneseText>……戦う時、だけ……</JapaneseText>
      <EnglishText>...Just in battles, huh...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>23</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275328</PointerOffset>
      <JapaneseText>あ……もしかして、
&lt;Mel&gt;のコスチュームに
ネコの耳がついてるのって</JapaneseText>
      <EnglishText>Oh... So wait, weren't
there cat ears stuck
to one of your costumes?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>23</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275428</PointerOffset>
      <JapaneseText>あっ……&lt;Mel&gt;が時々、
夜なべでコスチュームに
何かつけてるのって！</JapaneseText>
      <EnglishText>Oh...! I have seen &lt;Mel&gt;
attaching something to
her costumes late at night!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>25</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275480</PointerOffset>
      <JapaneseText>え……えへへ……</JapaneseText>
      <EnglishText>Eh... Ehehe...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>26</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275544</PointerOffset>
      <JapaneseText>どんだけ、
猫好きなんだぁっ！</JapaneseText>
      <EnglishText>Just how much do
you love cats!?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>27</Id>
      <Status>Editing</Status>
    </Entry>
