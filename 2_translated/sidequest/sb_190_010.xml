    <Entry>
      <PointerOffset>282140</PointerOffset>
      <JapaneseText>ケチー！</JapaneseText>
      <EnglishText>So stingy!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282184</PointerOffset>
      <JapaneseText>腹へった～</JapaneseText>
      <EnglishText>I'm hungry~</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281028</PointerOffset>
      <JapaneseText>よし、それがあれば……</JapaneseText>
      <EnglishText>Alright, so with this...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281080</PointerOffset>
      <JapaneseText>よし、できた！</JapaneseText>
      <EnglishText>Alright, done!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281140</PointerOffset>
      <JapaneseText>兄ちゃん！　これ、やる！</JapaneseText>
      <EnglishText>Hey, bro! Take this!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281188</PointerOffset>
      <JapaneseText>それ、弓か？</JapaneseText>
      <EnglishText>Huh, a bow?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281312</PointerOffset>
      <JapaneseText>ああ……
ダオスと戦った時に
使った武器だ</JapaneseText>
      <EnglishText>Yeah... It's the weapon I used
when we fought Dhaos.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>7</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281312</PointerOffset>
      <JapaneseText>でも、壊れたから、
押入れにしまっといたんだが……</JapaneseText>
      <EnglishText>But it ended up broken,
so I left it in the closet...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281388</PointerOffset>
      <JapaneseText>大切なもんなんだろ。
直しといてやった</JapaneseText>
      <EnglishText>It's kinda important to
you, right? So I fixed it.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281512</PointerOffset>
      <JapaneseText>大切なものか……
ま、あの戦いの
思い出の品だからな</JapaneseText>
      <EnglishText>Important, huh... Well,
yeah, there's a lot of
memories in this thing.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>10</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281512</PointerOffset>
      <JapaneseText>サンキュ、グリッド。
ミリーもジョンも</JapaneseText>
      <EnglishText>Thanks, Grid.
And Milly, too.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>10</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281700</PointerOffset>
      <JapaneseText>おお？
ちゃんと直ってる……</JapaneseText>
      <EnglishText>Oh? Hey, you did a
good job fixing this.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>12</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281700</PointerOffset>
      <JapaneseText>おまえが器用なのは
知ってたけど、
ここまでだったとはな</JapaneseText>
      <EnglishText>I knew you were good with
your hands, but I didn't
know you were this good.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>12</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281772</PointerOffset>
      <JapaneseText>オレは将来の武器職人だ！
任せとけ！</JapaneseText>
      <EnglishText>I'm gonna be a weaponmaker when
I'm older! Just leave that stuff to me!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281864</PointerOffset>
      <JapaneseText>よし、じゃあ、
その腕前が本物か、
実戦で試してきてやるぜ</JapaneseText>
      <EnglishText>Alright, then, I'll test this
out in a real battle. We'll
see how good you are!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281944</PointerOffset>
      <JapaneseText>私はグリッド兄ちゃんの
武器使う女戦士になる！</JapaneseText>
      <EnglishText>I'll be a lady warrior who
uses Grid's weapons!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281988</PointerOffset>
      <JapaneseText>腹へった～</JapaneseText>
      <EnglishText>I'm hungry~</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282096</PointerOffset>
      <JapaneseText>んじゃあ、帰ってきたら、
おまえらは特訓だ</JapaneseText>
      <EnglishText>Then, when I get back,
I'll have to train you guys.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>18</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282096</PointerOffset>
      <JapaneseText>それまで、
おとなしく待ってろよ</JapaneseText>
      <EnglishText>You'll behave yourselves
until then, yeah?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>18</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279936</PointerOffset>
      <JapaneseText>帰ったぞ！</JapaneseText>
      <EnglishText>Hey, I'm back!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>20</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279936</PointerOffset>
      <JapaneseText>あれ？　あいつら、
おかしいな……</JapaneseText>
      <EnglishText>Huh? That's pretty weird...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>20</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279984</PointerOffset>
      <JapaneseText>どうしたんだ？</JapaneseText>
      <EnglishText>What's up?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>22</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280064</PointerOffset>
      <JapaneseText>オレが帰ってきたら、
いつも飛んで出てくるのに</JapaneseText>
      <EnglishText>They always run out to meet
me as soon as I get here.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>23</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280148</PointerOffset>
      <JapaneseText>うふふ……
子どもはいつまでも
子どもじゃないんだよ</JapaneseText>
      <EnglishText>Mhmhm... Kids don't stay
kids forever, you know.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>24</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280208</PointerOffset>
      <JapaneseText>何だよ、それ</JapaneseText>
      <EnglishText>What's that supposed to mean?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>25</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280208</PointerOffset>
      <JapaneseText>おーい……</JapaneseText>
      <EnglishText>He~ey...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>25</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280256</PointerOffset>
      <JapaneseText>入っちゃダメ！</JapaneseText>
      <EnglishText>You can't come in!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>27</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280300</PointerOffset>
      <JapaneseText>腹へった～</JapaneseText>
      <EnglishText>I'm hungry~</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>28</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280352</PointerOffset>
      <JapaneseText>おいおい、なんだよ</JapaneseText>
      <EnglishText>Hey, what's the big deal?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>29</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280424</PointerOffset>
      <JapaneseText>&lt;Chester&gt;兄ちゃんは
入っちゃだめなんだよ</JapaneseText>
      <EnglishText>You can't come in here, &lt;Chester&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>30</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280484</PointerOffset>
      <JapaneseText>何だよ、どういうことだ？</JapaneseText>
      <EnglishText>Okay, what? What's this about?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>31</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280544</PointerOffset>
      <JapaneseText>またなんか悪巧みしてんな</JapaneseText>
      <EnglishText>Must be planning some
kind of prank again.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>32</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280596</PointerOffset>
      <JapaneseText>悪巧みじゃないよ</JapaneseText>
      <EnglishText>It's not a prank.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>33</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280640</PointerOffset>
      <JapaneseText>腹へった～</JapaneseText>
      <EnglishText>I'm hungry~</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>34</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280720</PointerOffset>
      <JapaneseText>わかった、わかった。
じゃ、あっち行ってるわ</JapaneseText>
      <EnglishText>Okay, okay. I'll go
over there, then.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>35</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280812</PointerOffset>
      <JapaneseText>お兄ちゃんたち、
黒精石持ってる～？</JapaneseText>
      <EnglishText>Oh, bro's friends, do you
have a Black Spirit Gem~?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>36</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280812</PointerOffset>
      <JapaneseText>持ってたら、ちょうだい</JapaneseText>
      <EnglishText>If you have one, can I have it?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>36</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280968</PointerOffset>
      <JapaneseText>やったー、ありがと</JapaneseText>
      <EnglishText>Yaaay, thanks.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>38</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280968</PointerOffset>
      <JapaneseText>グリッド兄ちゃん、
黒精石、手に入れたよ！</JapaneseText>
      <EnglishText>Grid, I got the
Black Spirit Gem!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>38</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
