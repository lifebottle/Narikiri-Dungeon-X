      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>281512</PointerOffset>
      <JapaneseText>それが現実、なんだ</JapaneseText>
      <EnglishText>That's reality.</EnglishText>
      <Notes/>
