    <Entry>
      <PointerOffset>279692</PointerOffset>
      <JapaneseText>ど、どうしよう……
こんな人いっぱいの
ところで……</JapaneseText>
      <EnglishText>Wh-What do I do...?
There's so many
people here...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279748</PointerOffset>
      <JapaneseText>&lt;Mel&gt;～がんばレ～！</JapaneseText>
      <EnglishText>We're rooting for you, &lt;Mel&gt;~!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279800</PointerOffset>
      <JapaneseText>かっこいいぞ～！</JapaneseText>
      <EnglishText>You're so cool!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279920</PointerOffset>
      <JapaneseText>……後にはひけない……</JapaneseText>
      <EnglishText>...I can't back out now...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279920</PointerOffset>
      <JapaneseText>ええいっ！！</JapaneseText>
      <EnglishText>Okay...!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279920</PointerOffset>
      <JapaneseText>歌います！！！　えっと……
『ミラクルボイス』！</JapaneseText>
      <EnglishText>I'll be singing, um...!
"Miracle Voice"!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279992</PointerOffset>
      <JapaneseText>ラ～ラララ～♪
ラララララララ～♪♪</JapaneseText>
      <EnglishText>La~ La la~
La la la la~!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280044</PointerOffset>
      <JapaneseText>私にはたくさんの</JapaneseText>
      <EnglishText>I have a lot</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280092</PointerOffset>
      <JapaneseText>夢が～ある～♪</JapaneseText>
      <EnglishText>Of dreams~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280152</PointerOffset>
      <JapaneseText>ケーキ屋さんにお姫さま～</JapaneseText>
      <EnglishText>The princess of a bakery~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280212</PointerOffset>
      <JapaneseText>アイドル歌手に美容師さん、</JapaneseText>
      <EnglishText>Or an idol's hairdresser~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280268</PointerOffset>
      <JapaneseText>そ～して～お嫁さん～∀</JapaneseText>
      <EnglishText>Or even just a mom~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280324</PointerOffset>
      <JapaneseText>だけど、わたしが本当に</JapaneseText>
      <EnglishText>But what I really</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280376</PointerOffset>
      <JapaneseText>欲しい～ぃのは～♪</JapaneseText>
      <EnglishText>Love the most~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280432</PointerOffset>
      <JapaneseText>みんなが笑顔になれる</JapaneseText>
      <EnglishText>Is that little tiny moment</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280480</PointerOffset>
      <JapaneseText>そんな瞬間～★</JapaneseText>
      <EnglishText>When I can make you all smile~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280528</PointerOffset>
      <JapaneseText>……ふぅ……</JapaneseText>
      <EnglishText>...Phew...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280584</PointerOffset>
      <JapaneseText>がんばったね、&lt;Mel&gt;</JapaneseText>
      <EnglishText>You did great, &lt;Mel&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>18</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280640</PointerOffset>
      <JapaneseText>すげー楽しそうだったな</JapaneseText>
      <EnglishText>That looked hella fun.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>19</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280752</PointerOffset>
      <JapaneseText>ふふふ……うん♪</JapaneseText>
      <EnglishText>Hahaha... It was.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>20</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280752</PointerOffset>
      <JapaneseText>人前で歌うのが、
こんなに気持ちいいなんて、
思わなかった！</JapaneseText>
      <EnglishText>I didn't think it'd feel
so good to sing for
an audience!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>20</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280796</PointerOffset>
      <JapaneseText>ふーん……</JapaneseText>
      <EnglishText>Hmm...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>22</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>280872</PointerOffset>
      <JapaneseText>&lt;Mel&gt;、
こういうお仕事に
向いてるのかもね</JapaneseText>
      <EnglishText>You might even be
able to make a
career out of it, &lt;Mel&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>23</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281044</PointerOffset>
      <JapaneseText>うーん……
そっかな……</JapaneseText>
      <EnglishText>Hmm...
You think so...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>24</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281044</PointerOffset>
      <JapaneseText>確かに気持ちよかったけど、
こんなの一度きりでいいよ</JapaneseText>
      <EnglishText>It was definitely nice, but
I think once was enough.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>24</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281044</PointerOffset>
      <JapaneseText>だって、すんごく
緊張したんだから……
心臓がきゅってなるくらい</JapaneseText>
      <EnglishText>'Cause I was still really
nervous... My heart felt
so tight in my chest!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>24</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281112</PointerOffset>
      <JapaneseText>でも、いい体験できて、
よかったね</JapaneseText>
      <EnglishText>But I'm glad you got to
experience something nice.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>27</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>281152</PointerOffset>
      <JapaneseText>うん！</JapaneseText>
      <EnglishText>Yeah!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>28</Id>
      <Status>Proofreading</Status>
    </Entry>
