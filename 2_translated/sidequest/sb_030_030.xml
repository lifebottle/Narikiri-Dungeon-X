  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>274464</PointerOffset>
      <JapaneseText>たいりょーたいりょーっと</JapaneseText>
      <EnglishText>This is a nice haul.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274520</PointerOffset>
      <JapaneseText>はぁああ……疲れた……</JapaneseText>
      <EnglishText>Phew... I'm beat...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274584</PointerOffset>
      <JapaneseText>お疲れ様。
休む準備してあるよ</JapaneseText>
      <EnglishText>Good work. We got dinner
and a bed ready for you.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274648</PointerOffset>
      <JapaneseText>&lt;Dio&gt;、
迷惑かけなかった？</JapaneseText>
      <EnglishText>&lt;Dio&gt; didn't cause you
any trouble, did he?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274744</PointerOffset>
      <JapaneseText>いやいや、こいつのおかげで
今日はなかなかの収穫だったぜ</JapaneseText>
      <EnglishText>Nah, not at all! We came out
with a ton today, thanks to him.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274792</PointerOffset>
      <JapaneseText>よかった……</JapaneseText>
      <EnglishText>Whew, that's good...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274868</PointerOffset>
      <JapaneseText>これは今日の日当だ。
受け取ってくれ</JapaneseText>
      <EnglishText>This is your wage for
today. Here, take it.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275008</PointerOffset>
      <JapaneseText>また、なんかあったら、
よろしくな</JapaneseText>
      <EnglishText>Thanks for all the help!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275084</PointerOffset>
      <JapaneseText>疲れたけど……
汗して働くって、いいよな</JapaneseText>
      <EnglishText>I'm beat, but... Something about working
up a sweat on the job feels pretty great...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275128</PointerOffset>
      <JapaneseText>あはっ……</JapaneseText>
      <EnglishText>Aha...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275180</PointerOffset>
      <JapaneseText>何だよ、その笑い</JapaneseText>
      <EnglishText>What're you laughing at?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275264</PointerOffset>
      <JapaneseText>ううん、すごく
いいこと言うなって。
&lt;Dio&gt;のくせに</JapaneseText>
      <EnglishText>No, it's just, you said
something pretty cool.
Well, cool for you, &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>12</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275408</PointerOffset>
      <JapaneseText>くせにって
なんだよ……もう</JapaneseText>
      <EnglishText>For me... What the
hell's...that mean...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>13</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275408</PointerOffset>
      <JapaneseText>……でも、本当に……
充実したっていうか、
気持ちいいっていうか……</JapaneseText>
      <EnglishText>...But, I feel really...fulfilled,
I guess...? ...Or, I dunno,
I just...feel good...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>13</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275408</PointerOffset>
      <JapaneseText>………………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>13</Id>
      <BubbleId>2</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275452</PointerOffset>
      <JapaneseText>&lt;Dio&gt;？</JapaneseText>
      <EnglishText>&lt;Dio&gt;?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>16</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275520</PointerOffset>
      <JapaneseText>くすっ……
立ったまま寝てる……</JapaneseText>
      <EnglishText>Hehe... He fell
asleep standing up...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>17</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275576</PointerOffset>
      <JapaneseText>&lt;Dio&gt;、ほら、起きて</JapaneseText>
      <EnglishText>&lt;Dio&gt;, hey, wake up.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>18</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275640</PointerOffset>
      <JapaneseText>え？　あ……え……
……あぁ</JapaneseText>
      <EnglishText>Eh? Oh...uh...
Aaahhhh...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>19</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275832</PointerOffset>
      <JapaneseText>はぁ……今日は
上がりなし、か……</JapaneseText>
      <EnglishText>Haaah... Not much to
show for today, huh...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>20</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275876</PointerOffset>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>21</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276256</PointerOffset>
      <JapaneseText>……まだまだオレ、未熟だな</JapaneseText>
      <EnglishText>...I still got a lot to learn, I guess.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>22</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276300</PointerOffset>
      <JapaneseText>&lt;Dio&gt;……</JapaneseText>
      <EnglishText>&lt;Dio&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>23</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276420</PointerOffset>
      <JapaneseText>元気出して。きみは毎日、
成長してるよ</JapaneseText>
      <EnglishText>Cheer up. You're growing
a little every day.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>24</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276420</PointerOffset>
      <JapaneseText>いつか、みんなの
役に立てるようになる日が
来るよ</JapaneseText>
      <EnglishText>One day, you'll be
able to help everyone
who needs it.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>24</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276468</PointerOffset>
      <JapaneseText>……かな……</JapaneseText>
      <EnglishText>...Maybe...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>26</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276512</PointerOffset>
      <JapaneseText>もちろん！</JapaneseText>
      <EnglishText>Absolutely!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>27</Id>
      <Status>Editing</Status>
    </Entry>
