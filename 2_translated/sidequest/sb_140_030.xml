    <Entry>
      <PointerOffset>269520</PointerOffset>
      <JapaneseText>あぁ……オレ、忘れ物……</JapaneseText>
      <EnglishText>Ah... I, uh, left something inside...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269564</PointerOffset>
      <JapaneseText>お待たせ～</JapaneseText>
      <EnglishText>Just a moment~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269612</PointerOffset>
      <JapaneseText>何、忘れたの？</JapaneseText>
      <EnglishText>What did you leave?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269688</PointerOffset>
      <JapaneseText>ちょっとな</JapaneseText>
      <EnglishText>Gimme a sec.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269688</PointerOffset>
      <JapaneseText>さっきの人んとこ、
戻るんだろ？</JapaneseText>
      <EnglishText>We should go back to that
guy from before, yeah?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269760</PointerOffset>
      <JapaneseText>お母さんが借金してた人の
ところだよね</JapaneseText>
      <EnglishText>Yes, the man whose mother
borrowed the money.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
