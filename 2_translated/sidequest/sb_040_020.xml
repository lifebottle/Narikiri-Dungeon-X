      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278552</PointerOffset>
      <JapaneseText>ど、どうしよう……</JapaneseText>
      <EnglishText>Wh-What should I do...</EnglishText>
      <Notes/>
