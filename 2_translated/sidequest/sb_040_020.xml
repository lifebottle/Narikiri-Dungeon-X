      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278724</PointerOffset>
      <JapaneseText>……あ、そっか……！</JapaneseText>
      <EnglishText>...Oh, I know...!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278724</PointerOffset>
      <JapaneseText>……未練多き罪深き魂よ、
生命の緒を断ち切り、
眠れ眠れ、静かに眠れ……！</JapaneseText>
      <EnglishText>O spirit bound by sin, cut loose
your mortal bonds! To sleep, to
slumber, in peace you must rest!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278780</PointerOffset>
      <JapaneseText>あれ？　あれ……！？</JapaneseText>
      <EnglishText>Huh? Huh...!?</EnglishText>
      <Notes/>
