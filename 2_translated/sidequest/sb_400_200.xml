    <Entry>
      <PointerOffset>292497,292547</PointerOffset>
      <JapaneseText>ジェストーナと……</JapaneseText>
      <EnglishText>What to do with Jestona?</EnglishText>
      <Notes/>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>291536</PointerOffset>
      <JapaneseText>寒いぜ……
心にぽっかり、
穴が開いてる……</JapaneseText>
      <EnglishText>It's cold... A gaping
hole in one's heart...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291620</PointerOffset>
      <JapaneseText>満たされぬ心の痛み……
わからせてやるよ！</JapaneseText>
      <EnglishText>The pain of a yearning heart...
I will make you understand!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291708</PointerOffset>
      <JapaneseText>心が痛ぇぜ……
心の穴に吹き込む風が
冷てぇ……</JapaneseText>
      <EnglishText>My heart's in pain... The
wind blowing through its
hole is so damned cold...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291940</PointerOffset>
      <JapaneseText>我、今、魔界の者に
ねがいたてまつる</JapaneseText>
      <EnglishText>Here and now, I offer my
request to this Daemon.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291940</PointerOffset>
      <JapaneseText>偉大なる者の盟約のもと、
我に彼の者を従わせたまえ</JapaneseText>
      <EnglishText>By covenant of the Great One,
may they obey me.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291940</PointerOffset>
      <JapaneseText>我が名は&lt;Dio&gt;</JapaneseText>
      <EnglishText>My name is &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>292000</PointerOffset>
      <JapaneseText>愛が欲しいんだよ……</JapaneseText>
      <EnglishText>I want love...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>292176</PointerOffset>
      <JapaneseText>往ね、俺の心の穴を
埋められんヤツは往ね……！</JapaneseText>
      <EnglishText>Get outta here! If you can't fill this
hole in my heart, just get out!</EnglishText>
      <Notes>wrong nametag -kev</Notes>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Problematic</Status>
    </Entry>
