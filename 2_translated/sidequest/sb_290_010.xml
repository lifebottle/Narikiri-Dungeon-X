    <Section>Main</Section>
    <Entry>
      <PointerOffset>273720</PointerOffset>
      <JapaneseText>クルール！！</JapaneseText>
      <EnglishText>Couleuru!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273768</PointerOffset>
      <JapaneseText>何、かな！？</JapaneseText>
      <EnglishText>Wh-What was that!?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273832</PointerOffset>
      <JapaneseText>何かが
落ちてきたんじゃねか？</JapaneseText>
      <EnglishText>I think something fell?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273880</PointerOffset>
      <JapaneseText>何かって何？</JapaneseText>
      <EnglishText>But what was it?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273948</PointerOffset>
      <JapaneseText>わかんねーけど……</JapaneseText>
      <EnglishText>I dunno, but...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273948</PointerOffset>
      <JapaneseText>行ってみよーぜ</JapaneseText>
      <EnglishText>Let's go check it out!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274036</PointerOffset>
      <JapaneseText>もう……考えなしで
飛び出す癖は治らないね、
ほんとに</JapaneseText>
      <EnglishText>Jeez... He'll never
stop running off
like that, will he?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274124</PointerOffset>
      <JapaneseText>それがなくなったら、
&lt;Dio&gt;は&lt;Dio&gt;じゃ
なくなるけどね</JapaneseText>
      <EnglishText>He wouldn't really be
&lt;Dio&gt; anymore if he did!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
