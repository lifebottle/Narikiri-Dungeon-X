  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>272364</PointerOffset>
      <JapaneseText>オレは、オレは
もっと才能がある、はず！</JapaneseText>
      <EnglishText>I'm sure I have so much
more talent than just this!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272364</PointerOffset>
      <JapaneseText>ヘイ、キミたち。
そう思わないかい？</JapaneseText>
      <EnglishText>Hey, you guys.
Don't you think so?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272428</PointerOffset>
      <JapaneseText>そんな、
急に言われてもさ……</JapaneseText>
      <EnglishText>Huh? I mean, I don't
really know you, so...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272484</PointerOffset>
      <JapaneseText>才能って何の、ですか？</JapaneseText>
      <EnglishText>What kind of talent do you mean?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272540</PointerOffset>
      <JapaneseText>作詞、だよ</JapaneseText>
      <EnglishText>For songwriting.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272592</PointerOffset>
      <JapaneseText>作詞、ですか……</JapaneseText>
      <EnglishText>Songwriting?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272660</PointerOffset>
      <JapaneseText>うぅぅぅん？？　キミ？</JapaneseText>
      <EnglishText>Hmmmmmm? You?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272720</PointerOffset>
      <JapaneseText>な、なんでしょうか……？</JapaneseText>
      <EnglishText>Wh-What is it...?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272844</PointerOffset>
      <JapaneseText>しなやかで、伸びやかな声！
いいね、ファンタスティック</JapaneseText>
      <EnglishText>A voice both elegant
and carefree! I like it!
It's magnifique!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272844</PointerOffset>
      <JapaneseText>いい歌、歌えそうじゃない？</JapaneseText>
      <EnglishText>You could sing a fine
song, couldn't you?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272916</PointerOffset>
      <JapaneseText>え？　え……？</JapaneseText>
      <EnglishText>Eh? Eh...?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272916</PointerOffset>
      <JapaneseText>……そ、そうなのかな？</JapaneseText>
      <EnglishText>...C-Could I?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272996</PointerOffset>
      <JapaneseText>……おまえ『歌姫』に
なりきれるから、だろ？</JapaneseText>
      <EnglishText>...You can roleplay as a
"Chanteuse," can't you?</EnglishText>
      <Notes>kevan said it should be costume -dragon</Notes>
      <SpeakerId>2</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273048</PointerOffset>
      <JapaneseText>そんなので……？</JapaneseText>
      <EnglishText>Just because of that...?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273180</PointerOffset>
      <JapaneseText>ファンタスティック！
今、びびびと来たよ、
音楽の神が降りて来たよ！</JapaneseText>
      <EnglishText>Magnifique! Through you, I can
feel it! The god of music has
descended upon us!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>15</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273180</PointerOffset>
      <JapaneseText>うぉおおおおっ！！</JapaneseText>
      <EnglishText>Oooooohhhhhh!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>15</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273324</PointerOffset>
      <JapaneseText>よし！　できた！
題して『まわれロンド』！</JapaneseText>
      <EnglishText>Alright! It's done! I call
it, "Whirling Rondo"!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>17</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273324</PointerOffset>
      <JapaneseText>もらってくれ、
そして高らかに歌い、
聞く者を魅了するんだ！</JapaneseText>
      <EnglishText>Please, take it! And as you
sing it, let your sonorous voice
captivate all who hear you!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>17</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273376</PointerOffset>
      <JapaneseText>はぁ……どうも……</JapaneseText>
      <EnglishText>Okaaay... Thanks...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>19</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273812</PointerOffset>
      <JapaneseText>キミたちにこんなこと
言ってもしょうがないケド</JapaneseText>
      <EnglishText>Well, not that there's any
use asking you about it.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>20</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273812</PointerOffset>
      <JapaneseText>よし……オレの
ほとばしるような才能を……
出な～い……</JapaneseText>
      <EnglishText>Alright... Then this great
flow of talent within me is...
...It's still all stopped up...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>20</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
