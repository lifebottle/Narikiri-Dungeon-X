    <Entry>
      <PointerOffset>297853,297907</PointerOffset>
      <JapaneseText>グレムリンレアーと……</JapaneseText>
      <EnglishText>What to do with Gremlin Lair?</EnglishText>
      <Notes/>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
