  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>295888</PointerOffset>
      <JapaneseText>あ！　おまえ……！</JapaneseText>
      <EnglishText>Hey! It's you...!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>295960</PointerOffset>
      <JapaneseText>確か&lt;Cless&gt;さんに
捕まってたんだよね？</JapaneseText>
      <EnglishText>You were captured by
&lt;Cless&gt;, weren't you?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296020</PointerOffset>
      <JapaneseText>ああ、でも逃げたって……</JapaneseText>
      <EnglishText>Yeah, but he escaped...</EnglishText>
      <Notes>previously said "I escaped", which doesn't make sense in context. -dragon</Notes>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Problematic</Status>
    </Entry>
    <Entry>
      <PointerOffset>296136</PointerOffset>
      <JapaneseText>ケケケ、なんだよ、
誰かと思えば、あん時の
ガキどもじゃねぇか</JapaneseText>
      <EnglishText>Kekeke... What's up? I was wonderin'
who it could be, and what do you
know, it's the brats from back then.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296136</PointerOffset>
      <JapaneseText>何の用だよ</JapaneseText>
      <EnglishText>Whaddya want?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296220</PointerOffset>
      <JapaneseText>なんだよ、オレを
掴まえようってのかい？</JapaneseText>
      <EnglishText>What, you're tryin'
to capture me?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296332</PointerOffset>
      <JapaneseText>ケケケ……
オレと戦って
捕まえようってのかい？</JapaneseText>
      <EnglishText>Kekeke... So you're
gonna fight me and
try to capture me?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296332</PointerOffset>
      <JapaneseText>そうはいかないよ！？</JapaneseText>
      <EnglishText>It's not gonna go down like that!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296456</PointerOffset>
      <JapaneseText>……グゲゲ……
ま、負けるとは……</JapaneseText>
      <EnglishText>...Guh... I-I lost...?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296456</PointerOffset>
      <JapaneseText>で、でもここで
捕まるわけにゃ
いかねーよ……</JapaneseText>
      <EnglishText>B-But I can't go
gettin' caught...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296508</PointerOffset>
      <JapaneseText>あっ……！　待て！</JapaneseText>
      <EnglishText>Ah...! Wait!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296576</PointerOffset>
      <JapaneseText>……森の中に
逃げられちゃったよ</JapaneseText>
      <EnglishText>...He ran into the woods.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296756</PointerOffset>
      <JapaneseText>グレムリンレアー、あんたの力、
貸してくれ</JapaneseText>
      <EnglishText>Gremlin Lair, lend
us your power.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296928</PointerOffset>
      <JapaneseText>なんだよ、オレの力を？
サファイアは……ふーん……
持ってるんだな</JapaneseText>
      <EnglishText>What, you want my power?
You'll need a Sapphi...hmph...
So you've got one, huh.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296928</PointerOffset>
      <JapaneseText>でも、ゴメンだね</JapaneseText>
      <EnglishText>But, you'll have to spare me.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296928</PointerOffset>
      <JapaneseText>ただ、
どうしてもってんなら、
オレを倒しな！</JapaneseText>
      <EnglishText>Unless... If you really
insist, you'll have
to beat me first!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296984</PointerOffset>
      <JapaneseText>むぎゅう……</JapaneseText>
      <EnglishText>Nngyuugh...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297120</PointerOffset>
      <JapaneseText>我、今、魔界の者に
ねがいたてまつる</JapaneseText>
      <EnglishText>Here and now, I offer my
request to this Daemon.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>18</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297120</PointerOffset>
      <JapaneseText>偉大なる者の盟約のもと、
我に彼の者を従わせたまえ</JapaneseText>
      <EnglishText>By covenant of the Great One,
may they obey me.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>18</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297120</PointerOffset>
      <JapaneseText>我が名は&lt;Dio&gt;</JapaneseText>
      <EnglishText>My name is &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>18</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297184</PointerOffset>
      <JapaneseText>ひ、卑怯だぞー！！</JapaneseText>
      <EnglishText>Th-This's a dirty trick...!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>21</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297412</PointerOffset>
      <JapaneseText>ハーン、サファイアも
持ってなくて、オレと契約？
無理無理</JapaneseText>
      <EnglishText>Huuuh? You wanna
pact with me without
a Sapphire? No way.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>22</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297412</PointerOffset>
      <JapaneseText>ま、持ってても
してやるとは限らんけどね</JapaneseText>
      <EnglishText>Not that I'd want to
even if you had one.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>22</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297532</PointerOffset>
      <JapaneseText>力のないガキに、
協力してやるギリはないしな</JapaneseText>
      <EnglishText>'Cause there's no point in workin'
with some powerless brats.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>24</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297532</PointerOffset>
      <JapaneseText>降魔術士にでも
なってから来な</JapaneseText>
      <EnglishText>Come back when you're
a Fallen Wizard.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>24</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
