  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>272176</PointerOffset>
      <JapaneseText>へん、また来たな！</JapaneseText>
      <EnglishText>Hmph, look what the
cat dragged in!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272280</PointerOffset>
      <JapaneseText>あ、きみ……！　聞いてよ、
ぼく、自分が何者なのか、
わかったんだよ！</JapaneseText>
      <EnglishText>Oh, it's you...! Listen, I
found out who I really am!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272368</PointerOffset>
      <JapaneseText>なんだよ……
別にそんなことに
興味なんてないっての</JapaneseText>
      <EnglishText>What the...? And what
made you think I care
about that at all?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272440</PointerOffset>
      <JapaneseText>そ、そっか……
そうだよね、ふふ……</JapaneseText>
      <EnglishText>O-Oh... Okay, sorry, haha...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272496</PointerOffset>
      <JapaneseText>気持ち悪いヤツ……</JapaneseText>
      <EnglishText>Creepy weirdo...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272552</PointerOffset>
      <JapaneseText>何しに来たんだよ</JapaneseText>
      <EnglishText>So what're you here for?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272628</PointerOffset>
      <JapaneseText>あの、もう一度、
ルナにお会いしたくて……</JapaneseText>
      <EnglishText>Um, we wanted to meet
with Luna again...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272724</PointerOffset>
      <JapaneseText>ルナお姉ちゃんは、
おまえらなんかには
会いたくないってさ</JapaneseText>
      <EnglishText>Yeah, well, Luna doesn't
want to see some
twerps like you.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272788</PointerOffset>
      <JapaneseText>勝手に
言ってんじゃねーよ！</JapaneseText>
      <EnglishText>You don't get to
decide that!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272980</PointerOffset>
      <JapaneseText>へーんだ。
そんなに会いたけりゃ、
来いってんだ</JapaneseText>
      <EnglishText>Hmph... If you really
want to see her so
bad, then follow me.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272980</PointerOffset>
      <JapaneseText>でも、途中でいろいろ、
しかけといたからな</JapaneseText>
      <EnglishText>But there's a lot of puzzles you'll
have to solve along the way.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272980</PointerOffset>
      <JapaneseText>頭悪い、おまえたちでは、
上まで簡単には
来られないだろうけどな</JapaneseText>
      <EnglishText>For a bunch of halfwits
like you, I don't think you'll
ever make it to the top.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273024</PointerOffset>
      <JapaneseText>なんだと！</JapaneseText>
      <EnglishText>What'd you just call me!?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273072</PointerOffset>
      <JapaneseText>んじゃあな</JapaneseText>
      <EnglishText>Bye.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273124</PointerOffset>
      <JapaneseText>あ、ちょっと……</JapaneseText>
      <EnglishText>Hey, wait...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273180</PointerOffset>
      <JapaneseText>やってやろうじゃねーか</JapaneseText>
      <EnglishText>Time to get going, I guess.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273232</PointerOffset>
      <JapaneseText>え？　行くの……？</JapaneseText>
      <EnglishText>Eh? We're going...?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273308</PointerOffset>
      <JapaneseText>行くに決まってるだろ。
誰が頭悪いって？</JapaneseText>
      <EnglishText>Yeah, of course we are.
We're not "halfwits."</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>18</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273384</PointerOffset>
      <JapaneseText>……んもう……
当初の目的、忘れてない？</JapaneseText>
      <EnglishText>...Umm... You didn't forget
what we came for, did you?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>19</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273472</PointerOffset>
      <JapaneseText>え？　当初の目的……
あ、ああ、
忘れてない、忘れてない</JapaneseText>
      <EnglishText>Eh? What we came for... Oh,
uh...yeah, right. I remember.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>20</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273524</PointerOffset>
      <JapaneseText>ま、いいけどね……</JapaneseText>
      <EnglishText>Well, it's fine either way...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>21</Id>
      <Status>Proofreading</Status>
    </Entry>
