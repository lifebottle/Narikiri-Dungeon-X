    <Entry>
      <PointerOffset>278328</PointerOffset>
      <JapaneseText>あ……僕、ちょっと
買い物に行ってくるよ</JapaneseText>
      <EnglishText>Ah... I, uh, need to go. For a moment. 
There's, uh, something I need to buy.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278428</PointerOffset>
      <JapaneseText>え？　&lt;Cless&gt;さん？
ほしいもんなら、オレらの
荷物から使っても……</JapaneseText>
      <EnglishText>Eh? What's up, &lt;Cless&gt;?
If there's something you want,
you can just take it from our stash...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278508</PointerOffset>
      <JapaneseText>いや、君たちの
荷物の中には
なかったから……</JapaneseText>
      <EnglishText>Oh, uh, no, well, you
didn't have any in
with your things, so...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278572</PointerOffset>
      <JapaneseText>あ、&lt;Cless&gt;さん……
って……</JapaneseText>
      <EnglishText>Ah, wait,
&lt;Cless&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278644</PointerOffset>
      <JapaneseText>あ、あの……わたし……
ちょっと……</JapaneseText>
      <EnglishText>Ah, um... I...
also have to...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278696</PointerOffset>
      <JapaneseText>どったの、&lt;Mint&gt;？</JapaneseText>
      <EnglishText>'Sup, &lt;Mint&gt;?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278768</PointerOffset>
      <JapaneseText>えっと……
…………</JapaneseText>
      <EnglishText>Umm...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278768</PointerOffset>
      <JapaneseText>すいません……！</JapaneseText>
      <EnglishText>Sorry...!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278812</PointerOffset>
      <JapaneseText>怪しい……</JapaneseText>
      <EnglishText>Sus...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278888</PointerOffset>
      <JapaneseText>もう、怪しいとかって
レベルじゃないだろ</JapaneseText>
      <EnglishText>Nah, that was way more
than just suspicious.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>278956</PointerOffset>
      <JapaneseText>どうされたのですか、
おふたりとも</JapaneseText>
      <EnglishText>I wonder what it could be.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279032</PointerOffset>
      <JapaneseText>&lt;Suzu&gt;ちゃんは～
知らなくてもいいのよぉ？</JapaneseText>
      <EnglishText>Aww, li'l &lt;Suzu&gt;~ Don't
you wanna know~?</EnglishText>
      <Notes/>
      <SpeakerId>7</SpeakerId>
      <Id>12</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279084</PointerOffset>
      <JapaneseText>よし……決めた！</JapaneseText>
      <EnglishText>Mmkay, I've decided!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>13</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279128</PointerOffset>
      <JapaneseText>何を……？</JapaneseText>
      <EnglishText>Decided what...?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>14</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279176</PointerOffset>
      <JapaneseText>覗きに行こう</JapaneseText>
      <EnglishText>I'm gonna spy on them!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>15</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279236</PointerOffset>
      <JapaneseText>やめとけって、おまえ……！</JapaneseText>
      <EnglishText>Hey, wait! Stop right there...!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>16</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279316</PointerOffset>
      <JapaneseText>んなこと言って、
あんたもついてくるくせに！</JapaneseText>
      <EnglishText>Yeah, you say that, but you're
following right behind me!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>17</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279364</PointerOffset>
      <JapaneseText>私も私も～♪</JapaneseText>
      <EnglishText>Me too, me too~!</EnglishText>
      <Notes/>
      <SpeakerId>7</SpeakerId>
      <Id>18</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279420</PointerOffset>
      <JapaneseText>……わ、私も行きます！</JapaneseText>
      <EnglishText>...I-I'll come, too!</EnglishText>
      <Notes/>
      <SpeakerId>8</SpeakerId>
      <Id>19</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279464</PointerOffset>
      <JapaneseText>クルール！</JapaneseText>
      <EnglishText>Couleuru!</EnglishText>
      <Notes/>
      <SpeakerId>9</SpeakerId>
      <Id>20</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279552</PointerOffset>
      <JapaneseText>お、おい、なんだよ、&lt;Mel&gt;も、
それに&lt;Couleur&gt;まで……</JapaneseText>
      <EnglishText>H-Hey, what the hell?
&lt;Mel&gt;, and even &lt;Couleur&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>21</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279608</PointerOffset>
      <JapaneseText>もう、あの子ったラ……</JapaneseText>
      <EnglishText>She's such a handful sometimes...</EnglishText>
      <Notes/>
      <SpeakerId>10</SpeakerId>
      <Id>22</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279664</PointerOffset>
      <JapaneseText>……オレも行こっかな</JapaneseText>
      <EnglishText>...I guess I'll go, too.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>23</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279732</PointerOffset>
      <JapaneseText>仲間はずれなのが
イヤなんでしょ</JapaneseText>
      <EnglishText>You just don't want
to be left out, right?</EnglishText>
      <Notes/>
      <SpeakerId>10</SpeakerId>
      <Id>24</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279788</PointerOffset>
      <JapaneseText>んなんじゃねってば！</JapaneseText>
      <EnglishText>Hey, I never said that!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>25</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279836</PointerOffset>
      <JapaneseText>ぼくたちは……</JapaneseText>
      <EnglishText>So I guess we...</EnglishText>
      <Notes/>
      <SpeakerId>10</SpeakerId>
      <Id>26</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279888</PointerOffset>
      <JapaneseText>行ってみましょうか</JapaneseText>
      <EnglishText>Should we go, as well?</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>27</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>279936</PointerOffset>
      <JapaneseText>あ、行くんだね</JapaneseText>
      <EnglishText>Okay, let's go.</EnglishText>
      <Notes/>
      <SpeakerId>10</SpeakerId>
      <Id>28</Id>
      <Status>Editing</Status>
    </Entry>
