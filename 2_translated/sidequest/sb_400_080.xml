  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>296080</PointerOffset>
      <JapaneseText>うわっ！</JapaneseText>
      <EnglishText>Whoa!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296164</PointerOffset>
      <JapaneseText>なんだよ、頭悪いくせに
なかなかやるじゃんよ</JapaneseText>
      <EnglishText>Huh, for a buncha halfwits, you're
more capable than I thought.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296276</PointerOffset>
      <JapaneseText>あんなもんでオレたちの
ジャマできるって思ってる
そっちが頭悪いんじゃないか？</JapaneseText>
      <EnglishText>If you thought something
like that could stop us,
maybe you're the halfwit.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296324</PointerOffset>
      <JapaneseText>なんだと！</JapaneseText>
      <EnglishText>What'd you just call me!?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296380</PointerOffset>
      <JapaneseText>&lt;Dio&gt;、やめなさい！</JapaneseText>
      <EnglishText>Stop it, &lt;Dio&gt;!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296428</PointerOffset>
      <JapaneseText>だってさ……</JapaneseText>
      <EnglishText>But, c'mon...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296500</PointerOffset>
      <JapaneseText>アルテミスも、
もういいかげんに
しなさい</JapaneseText>
      <EnglishText>You should also
put this argument
to rest, Artemis.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296544</PointerOffset>
      <JapaneseText>ルナ……！</JapaneseText>
      <EnglishText>Luna...!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296596</PointerOffset>
      <JapaneseText>だってさ……</JapaneseText>
      <EnglishText>But, c'mon...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296652</PointerOffset>
      <JapaneseText>皆さんをお通ししなさい</JapaneseText>
      <EnglishText>Allow everyone to pass.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296720</PointerOffset>
      <JapaneseText>わ、わかりました……</JapaneseText>
      <EnglishText>U-Understood...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>11</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296720</PointerOffset>
      <JapaneseText>フン……</JapaneseText>
      <EnglishText>Hmph...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>11</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296768</PointerOffset>
      <JapaneseText>なんだよ……</JapaneseText>
      <EnglishText>What's your deal...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296988</PointerOffset>
      <JapaneseText>寂しいんだね、あの子</JapaneseText>
      <EnglishText>He's lonely, I think.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296988</PointerOffset>
      <JapaneseText>誰にも必要とされなくて、
誰にも相手されなくて</JapaneseText>
      <EnglishText>No one needs him, and
no one talks to him.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296988</PointerOffset>
      <JapaneseText>必要とされる人や
ちやほやされる人に
嫉妬して……</JapaneseText>
      <EnglishText>When he sees people who are
needed and given attention by
others, he feels jealous...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296988</PointerOffset>
      <JapaneseText>気持ちがささくれだって、
だかラ……</JapaneseText>
      <EnglishText>And then he starts
to get irritable, and...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <BubbleId>3</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296988</PointerOffset>
      <JapaneseText>ぼくもそうだったから、
わかるんだ</JapaneseText>
      <EnglishText>I was like that,
too, so I get it.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <BubbleId>4</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297044</PointerOffset>
      <JapaneseText>そっか……
そうだよね</JapaneseText>
      <EnglishText>Oh... That makes sense.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>19</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297088</PointerOffset>
      <JapaneseText>さ、行こ</JapaneseText>
      <EnglishText>Well, let's go.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>20</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297136</PointerOffset>
      <JapaneseText>ふん……</JapaneseText>
      <EnglishText>Hmph...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>21</Id>
      <Status>Proofreading</Status>
    </Entry>
