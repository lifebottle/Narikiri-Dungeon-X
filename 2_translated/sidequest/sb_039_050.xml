  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>301764</PointerOffset>
      <JapaneseText>見つけてくれて
サンキュー！</JapaneseText>
      <EnglishText>Oh, you found me!
Thank you~!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>301820</PointerOffset>
      <JapaneseText>うわっ、また出た……！</JapaneseText>
      <EnglishText>Whoa, it's you again...!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>301892</PointerOffset>
      <JapaneseText>最近、どう？　どう？
どうよ？</JapaneseText>
      <EnglishText>How's it going lately? How? How??</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>301960</PointerOffset>
      <JapaneseText>どうって……
一応、元気だぜ……？</JapaneseText>
      <EnglishText>How? Uhh... I'm
good, I guess...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302156</PointerOffset>
      <JapaneseText>違ーうっ！　誰が！
あんたの調子を！
聞くかっっ！</JapaneseText>
      <EnglishText>Wroooong! Who!
Even asked you!
How you are!?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302156</PointerOffset>
      <JapaneseText>聞かせなさい！
あなた方の怒涛のごとし
包丁の轟きを！</JapaneseText>
      <EnglishText>Let me hear! The thunderous
crash of your kitchen knives!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302156</PointerOffset>
      <JapaneseText>見せなさい！
その疾風のごとし
華麗なる指先の舞踏を！</JapaneseText>
      <EnglishText>Let me see! The
tempestuous beauty
as your fingers dance!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302220</PointerOffset>
      <JapaneseText>それは料理を作れ
ってことか？</JapaneseText>
      <EnglishText>So you want us
to cook for you?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302276</PointerOffset>
      <JapaneseText>そうともいう</JapaneseText>
      <EnglishText>You could say that.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302328</PointerOffset>
      <JapaneseText>めんどくせーの……</JapaneseText>
      <EnglishText>Oh, come on...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302412</PointerOffset>
      <JapaneseText>ね、レシピくれたお礼に
なんか作ってあげようよ……</JapaneseText>
      <EnglishText>Let's make her something. She
did give us all of those recipes...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302492</PointerOffset>
      <JapaneseText>ま、いいけどよ</JapaneseText>
      <EnglishText>Well, okay.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302492</PointerOffset>
      <JapaneseText>タンス野郎！
剣持ってこい！！</JapaneseText>
      <EnglishText>Hey, closet freak!
Gimme my sword!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302596</PointerOffset>
      <JapaneseText>ちぇーーーいっ、待ったぁ！！</JapaneseText>
      <EnglishText>Heeeeey, stop right there!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>14</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302596</PointerOffset>
      <JapaneseText>……料理するのに、
剣って、なに？</JapaneseText>
      <EnglishText>You're cooking. Why would
you ever need a sword?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>14</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302672</PointerOffset>
      <JapaneseText>いや、だって
食材を切るのに、
必要だろ、剣</JapaneseText>
      <EnglishText>Well, I mean, how am I
supposed to chop the
ingredients without a sword?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302736</PointerOffset>
      <JapaneseText>てんちゅうぅぅっ！！</JapaneseText>
      <EnglishText>Divine Punishment~!!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302780</PointerOffset>
      <JapaneseText>うわっ……</JapaneseText>
      <EnglishText>Whoa...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>18</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302860</PointerOffset>
      <JapaneseText>これを使って
１００年反省しなさい！</JapaneseText>
      <EnglishText>Spend the next 100 years
reflecting on your sins!
And as you do, use this!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>19</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>302908</PointerOffset>
      <JapaneseText>これって包丁？</JapaneseText>
      <EnglishText>It's a kitchen knife?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>20</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303084</PointerOffset>
      <JapaneseText>名づけて
万能包丁κ！</JapaneseText>
      <EnglishText>Namely, the All-Purpose
Kitchen Knife κ!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>21</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303084</PointerOffset>
      <JapaneseText>食材の切り方ひとつで、
料理の味は変わってくるもの。
なのに、剣って、剣って……</JapaneseText>
      <EnglishText>How you cut your ingredients
has a great effect on the flavor!
And yet, to use a sword...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>21</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303084</PointerOffset>
      <JapaneseText>この、不届き者！！
野菜に謝れ！</JapaneseText>
      <EnglishText>You scoundrel! Say you're
sorry to your vegetables!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>21</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303136</PointerOffset>
      <JapaneseText>す、すいません……</JapaneseText>
      <EnglishText>I-I'm sorry...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>24</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303184</PointerOffset>
      <JapaneseText>肉はいいのかよ</JapaneseText>
      <EnglishText>So it's fine for meat?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>25</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303236</PointerOffset>
      <JapaneseText>肉に謝れ！</JapaneseText>
      <EnglishText>Say you're sorry
to your meat!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>26</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303284</PointerOffset>
      <JapaneseText>すいません……</JapaneseText>
      <EnglishText>I'm sorry...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>27</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303332</PointerOffset>
      <JapaneseText>魚はいいのかよ</JapaneseText>
      <EnglishText>So it's fine for fish?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>28</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303488</PointerOffset>
      <JapaneseText>魚に……</JapaneseText>
      <EnglishText>Say you're...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>29</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303488</PointerOffset>
      <JapaneseText>……えーいっ！！
とにかく使えっ！</JapaneseText>
      <EnglishText>...That's enough!
Anyway, use it!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>29</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303488</PointerOffset>
      <JapaneseText>包丁、逆から読んで
ちょーほー！
……調法するのよ！</JapaneseText>
      <EnglishText>Knife! N-I-F-E! Swap two letters
and that spells "fine"! It's the
finest tool you'll ever use!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>29</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303488</PointerOffset>
      <JapaneseText>では、サラバっ！！</JapaneseText>
      <EnglishText>And with that! Farewell!!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>29</Id>
      <BubbleId>3</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303536</PointerOffset>
      <JapaneseText>……疲れた……</JapaneseText>
      <EnglishText>...I'm so tired...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>33</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303608</PointerOffset>
      <JapaneseText>でも、いいもの
いただいちゃったね♪</JapaneseText>
      <EnglishText>But, she did give
us something nice!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>34</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>303680</PointerOffset>
      <JapaneseText>ああ……
ありがたく
使わせてもらおうぜ</JapaneseText>
      <EnglishText>Yeah... I'm kinda excited
to try it out.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>35</Id>
      <Status>Proofreading</Status>
    </Entry>
