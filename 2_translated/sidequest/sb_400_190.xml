    <Entry>
      <PointerOffset>291841,291891</PointerOffset>
      <JapaneseText>イシュラントと……</JapaneseText>
      <EnglishText>What to do with Ishrantu?</EnglishText>
      <Notes/>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>290876</PointerOffset>
      <JapaneseText>殺された恨み……
恨み……</JapaneseText>
      <EnglishText>The grudge of the murdered...
The grudge...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>290952</PointerOffset>
      <JapaneseText>この恨み……晴らす……
晴らすぅ！</JapaneseText>
      <EnglishText>This grudge...against
you... Against you...!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291044</PointerOffset>
      <JapaneseText>我が無念……
またここに降り積もる……</JapaneseText>
      <EnglishText>My regret... The grudge
lies here still...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291044</PointerOffset>
      <JapaneseText>恨めしい……</JapaneseText>
      <EnglishText>Hateful...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291264</PointerOffset>
      <JapaneseText>我、今、魔界の者に
ねがいたてまつる</JapaneseText>
      <EnglishText>Here and now, I offer my
request to this Daemon.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291264</PointerOffset>
      <JapaneseText>偉大なる者の盟約のもと、
我に彼の者を従わせたまえ</JapaneseText>
      <EnglishText>By covenant of the Great One,
may they obey me.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291264</PointerOffset>
      <JapaneseText>我が名は&lt;Dio&gt;</JapaneseText>
      <EnglishText>My name is &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291344</PointerOffset>
      <JapaneseText>我が暗き想い……
晴らさずにおくべきか</JapaneseText>
      <EnglishText>These dark feelings of mine...
Must they ever remain?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291520</PointerOffset>
      <JapaneseText>おまえらに我が恨み、
鎮めることすらできぬ……</JapaneseText>
      <EnglishText>You cannot quell this
grudge within me...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
  </Strings>
