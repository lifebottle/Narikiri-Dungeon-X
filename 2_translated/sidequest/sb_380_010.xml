  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>271840</PointerOffset>
      <JapaneseText>フンフンフン……♪</JapaneseText>
      <EnglishText>Hmhmhmhm~...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271840</PointerOffset>
      <JapaneseText>おわっ……なんじゃ、
おぬしら、来とったのか。
さっさと声をかけんか</JapaneseText>
      <EnglishText>Oh... What's this? All of you
are here? You should've told
me a little sooner.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271916</PointerOffset>
      <JapaneseText>いや、今から声かけようと
思ってたんだけど</JapaneseText>
      <EnglishText>Well, we were about
to tell you just now.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271968</PointerOffset>
      <JapaneseText>何してるんですか？</JapaneseText>
      <EnglishText>What are you doing?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272028</PointerOffset>
      <JapaneseText>人形を作っとるんじゃ</JapaneseText>
      <EnglishText>I'm making a doll.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272072</PointerOffset>
      <JapaneseText>人形……</JapaneseText>
      <EnglishText>A doll...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272148</PointerOffset>
      <JapaneseText>マクスウェルにそんな趣味が
あったんだ……</JapaneseText>
      <EnglishText>I didn't know you had a
hobby like that, Maxwell...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272216</PointerOffset>
      <JapaneseText>それって、
イベントに出したり？</JapaneseText>
      <EnglishText>Are you going to enter
it into a contest?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272312</PointerOffset>
      <JapaneseText>バカもの！　趣味ではない！
これはれっきとした仕事じゃ！</JapaneseText>
      <EnglishText>No, you fools! This is no hobby!
I'm doing respectable work here!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272360</PointerOffset>
      <JapaneseText>そ、そうなの？</JapaneseText>
      <EnglishText>I-Is it?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272436</PointerOffset>
      <JapaneseText>精霊が趣味など
持つわけなかろうが！</JapaneseText>
      <EnglishText>Why would a spirit
need a hobby!?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272528</PointerOffset>
      <JapaneseText>……ぼくは双子ちゃんたちの
面倒見るって仕事があるけド……</JapaneseText>
      <EnglishText>...Well, I do some work looking
after the twins, but...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272584</PointerOffset>
      <JapaneseText>んで、何の仕事だよ？</JapaneseText>
      <EnglishText>So, what kinda work's it for?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272640</PointerOffset>
      <JapaneseText>教えてほしいか？</JapaneseText>
      <EnglishText>You'd like to know?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272700</PointerOffset>
      <JapaneseText>いや、別にどっちでも……</JapaneseText>
      <EnglishText>Well, I don't really care...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272792</PointerOffset>
      <JapaneseText>教えてほしいなら、
ワシのために良質の土を
取ってこい</JapaneseText>
      <EnglishText>If you'd like to know,
go and fetch me some
High-Quality Soil.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272848</PointerOffset>
      <JapaneseText>どっちでもいいっての</JapaneseText>
      <EnglishText>I said I don't care either way.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272944</PointerOffset>
      <JapaneseText>人形を作るのに、
少し足りないのじゃ</JapaneseText>
      <EnglishText>I don't have quite enough
to finish this doll.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>18</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272944</PointerOffset>
      <JapaneseText>いいか、良質の土じゃ</JapaneseText>
      <EnglishText>You got that, didn't you?
High-Quality Soil.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>18</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273000</PointerOffset>
      <JapaneseText>だからどっちでも……</JapaneseText>
      <EnglishText>Look, I really don't care...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>20</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273048</PointerOffset>
      <JapaneseText>頼んだぞ</JapaneseText>
      <EnglishText>I'm counting on you.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>21</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273128</PointerOffset>
      <JapaneseText>精霊のくせに
耳まで遠いのかよ、
このじじぃ……</JapaneseText>
      <EnglishText>For a spirit, this old man's
sure hard of hearing...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>22</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273208</PointerOffset>
      <JapaneseText>心配してくれんでも、
耳はよう聞こえとる</JapaneseText>
      <EnglishText>Don't worry about me.
I can hear you just fine.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>23</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273276</PointerOffset>
      <JapaneseText>な、なんだよ……
聞こえてんのかよ</JapaneseText>
      <EnglishText>Wh-What the hell...
So he does hear me.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>24</Id>
      <Status>Proofreading</Status>
    </Entry>
