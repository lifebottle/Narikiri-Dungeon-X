    <Entry>
      <PointerOffset>280544</PointerOffset>
      <JapaneseText>手伝いますか？</JapaneseText>
      <EnglishText>Will you help?</EnglishText>
      <Notes/>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
