  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>276552</PointerOffset>
      <JapaneseText>はぁはぁ……</JapaneseText>
      <EnglishText>Haaah... Haaah...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276604</PointerOffset>
      <JapaneseText>遅いぞ、&lt;Dio&gt;！</JapaneseText>
      <EnglishText>You're too slow, &lt;Dio&gt;!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276676</PointerOffset>
      <JapaneseText>だ、だって……
&lt;Cless&gt;さん、早すぎ……</JapaneseText>
      <EnglishText>C-C'mon... &lt;Cless&gt;, you're
way too fast...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276756</PointerOffset>
      <JapaneseText>さぁ、特訓を続けるぞ！
次は素振り１０００回！</JapaneseText>
      <EnglishText>Okay, let's continue! Next
is 1000 practice swings!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276808</PointerOffset>
      <JapaneseText>きゅ、休憩なし～？</JapaneseText>
      <EnglishText>We...we're not taking a break?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276876</PointerOffset>
      <JapaneseText>だから、やめとけって
言っただろ</JapaneseText>
      <EnglishText>So, remember when I said you're
better off if you don't?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276948</PointerOffset>
      <JapaneseText>&lt;Cless&gt;さんは、
体力ありますから……</JapaneseText>
      <EnglishText>&lt;Cless&gt; has a great deal
of endurance, so...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277040</PointerOffset>
      <JapaneseText>くっ、くっそ……
ここでへばってたまるか！</JapaneseText>
      <EnglishText>D-Dammit... Like
hell am I tired!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277040</PointerOffset>
      <JapaneseText>お願いします！</JapaneseText>
      <EnglishText>I'm ready!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277100</PointerOffset>
      <JapaneseText>よし、それじゃ、
行くぞ！</JapaneseText>
      <EnglishText>Alright, then, let's go!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277176</PointerOffset>
      <JapaneseText>&lt;Dio&gt;って
本当、負けず嫌い
なんだかラ……</JapaneseText>
      <EnglishText>&lt;Dio&gt; really hates to quit...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277224</PointerOffset>
      <JapaneseText>へ、平気かな？</JapaneseText>
      <EnglishText>W-Will he be okay?</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277300</PointerOffset>
      <JapaneseText>……よ、よし……
柔招来、習得したぞ……！</JapaneseText>
      <EnglishText>...A-Alright... I learned it!</EnglishText>
      <Notes>needs arte name</Notes>
      <SpeakerId>1</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277352</PointerOffset>
      <JapaneseText>やったな、&lt;Dio&gt;</JapaneseText>
      <EnglishText>Nice job, &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277408</PointerOffset>
      <JapaneseText>おめでとうございます</JapaneseText>
      <EnglishText>Congratulations!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277472</PointerOffset>
      <JapaneseText>ほんと、
負けず嫌いなんだから</JapaneseText>
      <EnglishText>You really don't quit, do you?</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277516</PointerOffset>
      <JapaneseText>クルール～</JapaneseText>
      <EnglishText>Couleuru~</EnglishText>
      <Notes/>
      <SpeakerId>7</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277564</PointerOffset>
      <JapaneseText>よくやったね</JapaneseText>
      <EnglishText>You did well.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>18</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277620</PointerOffset>
      <JapaneseText>ありがとう、&lt;Cless&gt;さん</JapaneseText>
      <EnglishText>Thank you, &lt;Cless&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>19</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277708</PointerOffset>
      <JapaneseText>じゃあ、
ひとつ強くなったところで、
次、行ってみようか</JapaneseText>
      <EnglishText>So, now that you're
a little stronger, let's
go for round two.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>20</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277764</PointerOffset>
      <JapaneseText>も、もう勘弁して……</JapaneseText>
      <EnglishText>G-Give me a break...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>21</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277856</PointerOffset>
      <JapaneseText>顔色ひとつ変わってない、
&lt;Cless&gt;さんのほうが
スゴイよ……</JapaneseText>
      <EnglishText>&lt;Cless&gt; is incredible...
His cheeks haven't
even turned red...</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>22</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277916</PointerOffset>
      <JapaneseText>どんだけ体力あるんだか……</JapaneseText>
      <EnglishText>How much endurance
does he have, anyway...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>23</Id>
      <Status>Proofreading</Status>
    </Entry>
