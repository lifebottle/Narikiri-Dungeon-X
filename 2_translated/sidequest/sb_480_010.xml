    <Section>Main</Section>
    <Entry>
      <PointerOffset>271780</PointerOffset>
      <JapaneseText>どうしたんですか？
おじいさん</JapaneseText>
      <EnglishText>What's wrong, sir?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271872</PointerOffset>
      <JapaneseText>うちの猫が、どこかに
行ってしまったのニャ……</JapaneseText>
      <EnglishText>My cats have all gone
off on their own, nya...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271924</PointerOffset>
      <JapaneseText>ネコちゃんが……</JapaneseText>
      <EnglishText>Your cats...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272008</PointerOffset>
      <JapaneseText>そうなのニャ……
うぉーん、猫ちゃーん∀</JapaneseText>
      <EnglishText>That's right, nya... Ohh,
ki~tti~es, where are youuu~</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272084</PointerOffset>
      <JapaneseText>それは一大事です！
早く探さないと……！</JapaneseText>
      <EnglishText>This is a big problem! We
have to solve it at once!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272160</PointerOffset>
      <JapaneseText>ちょ、ちょっと、
どうしたの、&lt;Mel&gt;！？</JapaneseText>
      <EnglishText>W-Wait, what's wrong, Mel!?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272248</PointerOffset>
      <JapaneseText>だって、ネコちゃんが
いなくなったんだよ？</JapaneseText>
      <EnglishText>Well, his cats are missing!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272248</PointerOffset>
      <JapaneseText>大変だよ！</JapaneseText>
      <EnglishText>It's terrible!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272312</PointerOffset>
      <JapaneseText>どうしちゃったの、
&lt;Mel&gt;？</JapaneseText>
      <EnglishText>Are you okay, &lt;Mel&gt;?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272376</PointerOffset>
      <JapaneseText>変なスイッチ、
入ったぜ……</JapaneseText>
      <EnglishText>She's gone all weird, huh...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272424</PointerOffset>
      <JapaneseText>いってぇ……</JapaneseText>
      <EnglishText>Ow...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272512</PointerOffset>
      <JapaneseText>おじいさん、おじいさんの
ネコちゃん、見つけてきます！</JapaneseText>
      <EnglishText>Don't worry, sir! We'll
find your cats for you!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272580</PointerOffset>
      <JapaneseText>うぉおん、ありがとうよ</JapaneseText>
      <EnglishText>Ooooh, thank you.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272640</PointerOffset>
      <JapaneseText>&lt;Dio&gt;、エト！　行こっ！！</JapaneseText>
      <EnglishText>&lt;Dio&gt;, Ethos! Let's go!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272720</PointerOffset>
      <JapaneseText>……いつになく、
&lt;Mel&gt;が積極的すぎるぞ……</JapaneseText>
      <EnglishText>...She's gone totally off
her rocker, hasn't she...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272764</PointerOffset>
      <JapaneseText>うん……</JapaneseText>
      <EnglishText>Mm...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272808</PointerOffset>
      <JapaneseText>ほぉらっ！</JapaneseText>
      <EnglishText>C'mon!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
