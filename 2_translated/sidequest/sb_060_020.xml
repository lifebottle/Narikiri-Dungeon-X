    <Entry>
      <PointerOffset>273332</PointerOffset>
      <JapaneseText>獲物が
茂みの方に逃げたぞ！</JapaneseText>
      <EnglishText>Our prey's running for
the trees, over there!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273388</PointerOffset>
      <JapaneseText>ダメだ、早すぎる……！</JapaneseText>
      <EnglishText>It's too fast...!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273452</PointerOffset>
      <JapaneseText>&lt;Cless&gt;さん、
オレに任せて！</JapaneseText>
      <EnglishText>I can take this
one, &lt;Cless&gt;!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273496</PointerOffset>
      <JapaneseText>君に……？</JapaneseText>
      <EnglishText>You can...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273592</PointerOffset>
      <JapaneseText>ああ、オレの狙撃の腕、
見ててくれよ</JapaneseText>
      <EnglishText>Yeah, lemme show
you my bow arm.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273592</PointerOffset>
      <JapaneseText>なりきり！　クロスシフト！</JapaneseText>
      <EnglishText>Roleplay! Cross Shift!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273636</PointerOffset>
      <JapaneseText>覚悟ぉっ！</JapaneseText>
      <EnglishText>You ready for this!?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273708</PointerOffset>
      <JapaneseText>刺さった……！
しとめたぞ！</JapaneseText>
      <EnglishText>It's a hit...!
It's down!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
