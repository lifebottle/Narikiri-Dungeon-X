    <Entry>
      <PointerOffset>270920</PointerOffset>
      <JapaneseText>ああ、忙しい、忙しい……</JapaneseText>
      <EnglishText>Ahh, we're so busy...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270920</PointerOffset>
      <JapaneseText>ん？はい！
ご注文ですか？</JapaneseText>
      <EnglishText>Huh? Oh, hello! Are
you ready to order?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270996</PointerOffset>
      <JapaneseText>あ、いや、わたしたちは
そうじゃなくて……</JapaneseText>
      <EnglishText>Oh, um, no! We're not here to eat...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>271196</PointerOffset>
      <JapaneseText>ということは……
バイトォォォォォー！？</JapaneseText>
      <EnglishText>...Wait, you mean...
You're looking for work!?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>271196</PointerOffset>
      <JapaneseText>やたー！
これで人手不足は解消よ！？</JapaneseText>
      <EnglishText>Oh wow! We'll finally have enough staff!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>271196</PointerOffset>
      <JapaneseText>うん！即、採用ッ！
店長にはあたしが話しておくわ。
じゃあ早速行きましょうか！！</JapaneseText>
      <EnglishText>Okay! You're hired! I'll tell the
owner, so let's get you started!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>2</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>271248</PointerOffset>
      <JapaneseText>え？
あ、あの……</JapaneseText>
      <EnglishText>Eh? Umm, that's...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>271316</PointerOffset>
      <JapaneseText>人の話、まったく聞いてねぇし……</JapaneseText>
      <EnglishText>She doesn't listen very well, huh...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
