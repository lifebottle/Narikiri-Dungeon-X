  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>273800</PointerOffset>
      <JapaneseText>あら……帰ってきたの？</JapaneseText>
      <EnglishText>Oh my... You're back?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273900</PointerOffset>
      <JapaneseText>帰ってきたの、とは何だ。
ここは私の家だ。
帰ってきても構わないだろ</JapaneseText>
      <EnglishText>"Oh, you're back"? What's that
about? It's my own house.
Who cares if I come back to it.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273960</PointerOffset>
      <JapaneseText>ダメだとは言ってないわよ</JapaneseText>
      <EnglishText>I didn't say it was bad.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274016</PointerOffset>
      <JapaneseText>……まったく、もう……</JapaneseText>
      <EnglishText>...*grumble*...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274080</PointerOffset>
      <JapaneseText>……相変わらず
仲がいいね……</JapaneseText>
      <EnglishText>...They really do
get along so well...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274128</PointerOffset>
      <JapaneseText>え……どこが？</JapaneseText>
      <EnglishText>Uh... How's that?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274192</PointerOffset>
      <JapaneseText>&lt;Mel&gt;、&lt;Dio&gt;に
言っても……</JapaneseText>
      <EnglishText>I don't think &lt;Dio&gt; will
understand, &lt;Mel&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274240</PointerOffset>
      <JapaneseText>そうだね……</JapaneseText>
      <EnglishText>Yeah, you're right...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274356</PointerOffset>
      <JapaneseText>そうそう</JapaneseText>
      <EnglishText>Oh, right.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274356</PointerOffset>
      <JapaneseText>あなたの留守中に掃除してたら、
棚の奥から、こんなものが
見つかったわよ</JapaneseText>
      <EnglishText>I was cleaning while you were
away, and I found this tucked
away at the back of a shelf.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274396</PointerOffset>
      <JapaneseText>何だ？</JapaneseText>
      <EnglishText>What's that?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274448</PointerOffset>
      <JapaneseText>お父様からの手紙</JapaneseText>
      <EnglishText>A letter from your father.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274496</PointerOffset>
      <JapaneseText>……捨てとけ</JapaneseText>
      <EnglishText>...Throw it out.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274544</PointerOffset>
      <JapaneseText>ちょっと……</JapaneseText>
      <EnglishText>That's...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274612</PointerOffset>
      <JapaneseText>どうせろくなこと、
書いてないんだ</JapaneseText>
      <EnglishText>It won't be anything
worth reading.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274680</PointerOffset>
      <JapaneseText>あなたに渡したいものが
あるって</JapaneseText>
      <EnglishText>It says there was something
he wanted to give you.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274800</PointerOffset>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274800</PointerOffset>
      <JapaneseText>い、いや……
どうせろくなもんじゃない</JapaneseText>
      <EnglishText>...A-Anyway... It won't be
anything worth the time.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274800</PointerOffset>
      <JapaneseText>植物の標本とか、
図鑑とかそんなことだろ</JapaneseText>
      <EnglishText>It'll just be a plant specimen or
an encyclopedia or something.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274876</PointerOffset>
      <JapaneseText>本当にもう</JapaneseText>
      <EnglishText>Really...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>20</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274876</PointerOffset>
      <JapaneseText>……この手紙、
持っていって</JapaneseText>
      <EnglishText>...Please take this
letter with you.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>20</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274924</PointerOffset>
      <JapaneseText>え……でも……</JapaneseText>
      <EnglishText>Uh...but...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>22</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275148</PointerOffset>
      <JapaneseText>お父さんから&lt;Klarth&gt;に宛てた
言葉が書いてあるから</JapaneseText>
      <EnglishText>Since it's addressed to
&lt;Klarth&gt;, from his father.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>23</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275148</PointerOffset>
      <JapaneseText>お父さんの
残したもののありかも</JapaneseText>
      <EnglishText>And it says where to find
the gift he left behind.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>23</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275148</PointerOffset>
      <JapaneseText>機会があったら、こっそり
渡しといてくれればいいわ</JapaneseText>
      <EnglishText>If you have a chance, please
just slip it into his things.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>23</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275148</PointerOffset>
      <JapaneseText>私の前だから意地張ってるけど
本当は読みたいに決まってる</JapaneseText>
      <EnglishText>He's always stubborn in front of me,
but I know he wants to read it.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>23</Id>
      <BubbleId>3</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275212</PointerOffset>
      <JapaneseText>そっか。
んじゃあ、預かるよ</JapaneseText>
      <EnglishText>Okay. Then, I'll hold onto it.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>27</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275256</PointerOffset>
      <JapaneseText>お願いね</JapaneseText>
      <EnglishText>Please.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>28</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275408</PointerOffset>
      <JapaneseText>どうしてあの人、
素直になれないのかしら……</JapaneseText>
      <EnglishText>I wonder why he won't
be more honest...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>29</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275408</PointerOffset>
      <JapaneseText>本当はお父さんのこと、
好きでしょうがないくせに……</JapaneseText>
      <EnglishText>Even though I know he
loves his father so much...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>29</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275408</PointerOffset>
      <JapaneseText>……いつものことか</JapaneseText>
      <EnglishText>...But perhaps it's always like this.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>29</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
