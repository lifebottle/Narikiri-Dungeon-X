    <Entry>
      <PointerOffset>292280,292324</PointerOffset>
      <JapaneseText>アスカと……</JapaneseText>
      <EnglishText>What to do with Aska?</EnglishText>
      <Notes/>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>291416</PointerOffset>
      <JapaneseText>このようなところまで、
私に何用でしょうか</JapaneseText>
      <EnglishText>What errand could bring
you all the way here?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291516</PointerOffset>
      <JapaneseText>私と戦いたいのですか……</JapaneseText>
      <EnglishText>You wish to battle me...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291516</PointerOffset>
      <JapaneseText>わかりました、
お相手してさしあげましょう</JapaneseText>
      <EnglishText>Understood. Allow me
to be your opponent.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291624</PointerOffset>
      <JapaneseText>これがあなた方が
してきた長い旅の
成果なのですね</JapaneseText>
      <EnglishText>So this is the result
of your long travels.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291624</PointerOffset>
      <JapaneseText>見させていただきました</JapaneseText>
      <EnglishText>I have borne witness.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291800</PointerOffset>
      <JapaneseText>アスカ！
オレらに力を貸してくれ！</JapaneseText>
      <EnglishText>Aska! Lend us your power!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291884</PointerOffset>
      <JapaneseText>私の力でよければ、
貸しましょう</JapaneseText>
      <EnglishText>If my power pleases
you, you may have it.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>291884</PointerOffset>
      <JapaneseText>トパーズを我が前に</JapaneseText>
      <EnglishText>Present the Topaz Ring.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>292008</PointerOffset>
      <JapaneseText>我、今、光の精に
ねがいたてまつる</JapaneseText>
      <EnglishText>Here and now, I offer my request
to the Spirit of Light.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>292008</PointerOffset>
      <JapaneseText>指輪の盟約のもと、
我に精霊を従わせたまえ</JapaneseText>
      <EnglishText>By covenant of the ring,
may this spirit obey me.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>292008</PointerOffset>
      <JapaneseText>我が名は&lt;Dio&gt;</JapaneseText>
      <EnglishText>My name is &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>292072</PointerOffset>
      <JapaneseText>あなたのお役に立てますように</JapaneseText>
      <EnglishText>I hope that I shall be of aid to you.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>292224</PointerOffset>
      <JapaneseText>私との契約には、
トパーズが必要です</JapaneseText>
      <EnglishText>To form a pact with me, you
will need the Topaz Ring.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
