    <Entry>
      <PointerOffset>291947,291981</PointerOffset>
      <JapaneseText>ルナと……</JapaneseText>
      <EnglishText>What to do with Luna?</EnglishText>
      <Notes/>
      <Id>9</Id>
      <Status>Editing</Status>
