    <Entry>
      <PointerOffset>270360</PointerOffset>
      <JapaneseText>なんで、
こんなところに
ねこが……？</JapaneseText>
      <EnglishText>Wait, why's there
a cat down here?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270416</PointerOffset>
      <JapaneseText>とにかく、捕まえるぜ！</JapaneseText>
      <EnglishText>Anyway, let's catch it!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270468</PointerOffset>
      <JapaneseText>ニャーーン！</JapaneseText>
      <EnglishText>Nya~~n!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270588</PointerOffset>
      <JapaneseText>&lt;Dio&gt;、ダメだって！
捕まえるとか
そういうんじゃなくて！</JapaneseText>
      <EnglishText>&lt;Dio&gt;, stop it!
We're not trying
to capture them!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270588</PointerOffset>
      <JapaneseText>怖くないよぉ……
ニャーン……</JapaneseText>
      <EnglishText>Don't be scared...
Nya~n...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270640</PointerOffset>
      <JapaneseText>ニャーン……？</JapaneseText>
      <EnglishText>Nya~n...?</EnglishText>
      <Notes/>
