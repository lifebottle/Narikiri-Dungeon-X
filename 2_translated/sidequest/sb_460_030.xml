    <Entry>
      <PointerOffset>276308</PointerOffset>
      <JapaneseText>…………？</JapaneseText>
      <EnglishText>...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276352</PointerOffset>
      <JapaneseText>…………？</JapaneseText>
      <EnglishText>...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276476</PointerOffset>
      <JapaneseText>ああ、あんた……
いや……</JapaneseText>
      <EnglishText>Oh, you're... No...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276476</PointerOffset>
      <JapaneseText>ああ……何か大切なことを
誰かに……伝えなくては……</JapaneseText>
      <EnglishText>There's...something important...
I have to tell someone...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276532</PointerOffset>
      <JapaneseText>きゃっ……魔物……！？</JapaneseText>
      <EnglishText>Ahh!... A monster!?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276584</PointerOffset>
      <JapaneseText>&lt;Rody&gt;、すげー</JapaneseText>
      <EnglishText>Damn, that was amazing, &lt;Rody&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276700</PointerOffset>
      <JapaneseText>軽い軽い♪</JapaneseText>
      <EnglishText>Easy as pie~</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276700</PointerOffset>
      <JapaneseText>なんだったら、
&lt;Dio&gt;くんにもこんな感じの
すんごい技、教えてあげるよ？</JapaneseText>
      <EnglishText>But if you'd like, I
can teach you to
do the same thing?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276748</PointerOffset>
      <JapaneseText>ほんとにか？</JapaneseText>
      <EnglishText>Really?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276800</PointerOffset>
      <JapaneseText>ほんとにほんとに</JapaneseText>
      <EnglishText>Yeah, really.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276884</PointerOffset>
      <JapaneseText>……その技……
それは……ああっ……！</JapaneseText>
      <EnglishText>...That arte... That was... Ahh...!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276968</PointerOffset>
      <JapaneseText>あれ……？</JapaneseText>
      <EnglishText>Huh...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276968</PointerOffset>
      <JapaneseText>ね……どこかで……
会ってない、かな？</JapaneseText>
      <EnglishText>Hey, um... Have we...
met before, maybe?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277064</PointerOffset>
      <JapaneseText>いいや……知らない……
あんたなんて知らない……！</JapaneseText>
      <EnglishText>Nnooo... I don't know you...
I've never met you!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277112</PointerOffset>
      <JapaneseText>………………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277164</PointerOffset>
      <JapaneseText>なんだよ、あれ？</JapaneseText>
      <EnglishText>What the hell's
that about?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277224</PointerOffset>
      <JapaneseText>知り合い……
なんですか？</JapaneseText>
      <EnglishText>Do you know him?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277324</PointerOffset>
      <JapaneseText>わかんない</JapaneseText>
      <EnglishText>I'm not sure.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>18</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277324</PointerOffset>
      <JapaneseText>私はどこかで会ったこと
あるような気がするんだけど……</JapaneseText>
      <EnglishText>I have a feeling I've seen him
somewhere before, but...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>18</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277396</PointerOffset>
      <JapaneseText>向こうもなんか
知ってるふうだったぜ？</JapaneseText>
      <EnglishText>He was kinda acting like
he knows you, too.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>20</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277440</PointerOffset>
      <JapaneseText>……だね</JapaneseText>
      <EnglishText>...Yeah, he was.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>21</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277524</PointerOffset>
      <JapaneseText>&lt;Klarth&gt;さん、
あの人のこと、
ご存知ないんですか？</JapaneseText>
      <EnglishText>Do you know anything
about that man, &lt;Klarth&gt;?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>22</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277616</PointerOffset>
      <JapaneseText>あ、いや？
私はあんな村人がいたことすら
知らなかったが……</JapaneseText>
      <EnglishText>Uhh...no? I had no idea
anyone like that was
living in the village.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>23</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277696</PointerOffset>
      <JapaneseText>こんな小さい村なのに、
そんなことあるんだな</JapaneseText>
      <EnglishText>You really don't know him? Even
though it's such a small village.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>24</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277744</PointerOffset>
      <JapaneseText>いや……まぁな</JapaneseText>
      <EnglishText>I don't, no...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>25</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277828</PointerOffset>
      <JapaneseText>たぶん、絶対、
どこかで会ってる
はずなんだけど……</JapaneseText>
      <EnglishText>I think... I'm sure...
I've definitely met
him somewhere.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>26</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277876</PointerOffset>
      <JapaneseText>どこで……？</JapaneseText>
      <EnglishText>Where, though...?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>27</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277996</PointerOffset>
      <JapaneseText>さぁ……
上手く思い出せない……
ともかく……</JapaneseText>
      <EnglishText>Dunno... I can't seem to
remember... Anyway...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>28</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>277996</PointerOffset>
      <JapaneseText>&lt;Dio&gt;くん、
技、教えてほしいんでしょ？</JapaneseText>
      <EnglishText>&lt;Dio&gt;, don't you want me
to teach you that arte?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>28</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278064</PointerOffset>
      <JapaneseText>よかった、
忘れてっかと思ったぜ</JapaneseText>
      <EnglishText>Oh, hey, yeah. I was
scared you'd forget.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>30</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278184</PointerOffset>
      <JapaneseText>約束は忘れない。
それが
&lt;Rondoline&gt;さんだよ？</JapaneseText>
      <EnglishText>Hey, this is &lt;Rondoline&gt; you're talking
to. I'd never forget a promise.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>31</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278184</PointerOffset>
      <JapaneseText>よし、んじゃあ、
いっちょ、
修行といきますか</JapaneseText>
      <EnglishText>Alright, then, let's
do some training.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>31</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
