      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276192</PointerOffset>
      <JapaneseText>ふはぁ～もうイヤ……
なのに……なんで
見ちゃうんだろ、わたし</JapaneseText>
