    <Entry>
      <PointerOffset>262364</PointerOffset>
      <JapaneseText>準備はいいのかい？</JapaneseText>
      <EnglishText>Are we all set?</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>64</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>262556</PointerOffset>
      <JapaneseText>はい　　　　　
いいえ</JapaneseText>
      <EnglishText>Yes　　　　　
No</EnglishText>
      <Notes/>
      <SpeakerId>7</SpeakerId>
      <Id>65</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>262992</PointerOffset>
      <JapaneseText>焦らなくてもいいから
しっかり準備しておいで</JapaneseText>
      <EnglishText>No need to rush. Let's get
everything in order first.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>66</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>263216</PointerOffset>
      <JapaneseText>しっかり準備してってください。
お金は取りますけどね</JapaneseText>
      <EnglishText>Please take whatever you need.
You'll still have to pay for it, though.</EnglishText>
      <Notes/>
      <SpeakerId>8</SpeakerId>
      <Id>67</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>263424</PointerOffset>
      <JapaneseText>準備はいいですか？</JapaneseText>
      <EnglishText>Got everything you need?</EnglishText>
