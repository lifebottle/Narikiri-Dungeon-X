    </Entry>
    <Entry>
      <PointerOffset>274024</PointerOffset>
      <JapaneseText>気をつけていきなよぅ</JapaneseText>
      <EnglishText>Stay safe out there.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>25</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274028</PointerOffset>
      <JapaneseText>よぃーす、
どうかね、何か欲しいもんとか
あったりせんかい</JapaneseText>
      <EnglishText>Heyo. So wassup,
you got something
you're after?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>26</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274028</PointerOffset>
      <JapaneseText>ほれほれ</JapaneseText>
      <EnglishText>Take a look.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>26</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274032</PointerOffset>
      <JapaneseText>_shop_</JapaneseText>
      <EnglishText>_shop_</EnglishText>
