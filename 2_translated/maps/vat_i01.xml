    </Entry>
    <Entry>
      <PointerOffset>274016</PointerOffset>
      <JapaneseText>生活必需品だかんね</JapaneseText>
      <EnglishText>We sell, like, essentials, so...
People still gotta live, right?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>22</Id>
      <BubbleId>1</BubbleId>
