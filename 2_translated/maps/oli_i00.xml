    </Entry>
    <Entry>
      <PointerOffset>277072</PointerOffset>
      <JapaneseText>いらっしゃいませぇ
道具屋「スパイシー」でぇす</JapaneseText>
      <EnglishText>Weeelllcome. Thiis iis the
item shop, "Spiicyyy".</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>31</Id>
      <Status>Editing</Status>
    </Entry>
