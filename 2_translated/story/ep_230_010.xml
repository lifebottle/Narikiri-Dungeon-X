    <Entry>
      <PointerOffset>308524</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_001&gt;</VoiceId>
      <JapaneseText>うぉ……瘴気が……</JapaneseText>
      <EnglishText>Oh crap, the Miasma...!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>308612</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_002&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;、
エレメンツポットを……！</JapaneseText>
      <EnglishText>&lt;Dio&gt;, use the Elements' Pot!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>308688</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_003&gt;</VoiceId>
      <JapaneseText>よし、これで中へ入れるな</JapaneseText>
      <EnglishText>Yes! Now we can explore further in!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>308764</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_004&gt;</VoiceId>
      <JapaneseText>それでは……行きましょう</JapaneseText>
      <EnglishText>In that case...let us proceed.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>308852</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_005&gt;</VoiceId>
      <JapaneseText>エト、だいじょーぶか？
行けっか？</JapaneseText>
      <EnglishText>Hey, Eto, are you ok? Can you move?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>308924</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_006&gt;</VoiceId>
      <JapaneseText>え？　あ、うん……</JapaneseText>
      <EnglishText>Wh-Wha? Yeah...</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309016</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_007&gt;</VoiceId>
      <JapaneseText>あんまぼっとしてっと、
魔物に食われっぞ</JapaneseText>
      <EnglishText>You don't look very relaxed.
Afraid a monster will eat you?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309080</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_008&gt;</VoiceId>
      <JapaneseText>あの子……</JapaneseText>
      <EnglishText>You cheeky little...</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309180</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_009&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;なりにエトを
気遣ってるんだよ、
あれでも</JapaneseText>
      <EnglishText>In his own way, &lt;Dio&gt; is
trying to cheer you up.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309340</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_010&gt;</VoiceId>
      <JapaneseText>……ダメだな、ぼく。
こんなんじゃ、お母さん失格だ</JapaneseText>
      <EnglishText>...That's no good, though.
At this rate I won't be
good enough as a mom.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>10</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309340</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_011&gt;</VoiceId>
      <JapaneseText>……よし！　行くよ、
&lt;Dio&gt;、&lt;Mel&gt;！</JapaneseText>
      <EnglishText>Got to put on my best face!
Let's go &lt;Dio&gt;, &lt;Mel&gt;!</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>10</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309432</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_012&gt;</VoiceId>
      <JapaneseText>待ってください。
&lt;Rody&gt;さんは……？</JapaneseText>
      <EnglishText>Hold on a second, where is &lt;Rody&gt;...?</EnglishText>
      <Notes/>
      <SpeakerId>7</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309496</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_013&gt;</VoiceId>
      <JapaneseText>あれ……？</JapaneseText>
      <EnglishText>Huh...?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309580</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_014&gt;</VoiceId>
      <JapaneseText>ゴメンゴメン～
ちょっと野暮用で</JapaneseText>
      <EnglishText>Super sorry, guys! Had some
business to take care of!</EnglishText>
      <Notes/>
      <SpeakerId>8</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309652</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_015&gt;</VoiceId>
      <JapaneseText>どこ行ってたんだよ？</JapaneseText>
      <EnglishText>Where did you go?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>309952</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_019&gt;</VoiceId>
      <JapaneseText>乙女のヒ・ミ・ツ、よね？</JapaneseText>
      <EnglishText>That's a girl's S.E.C.R.E.T., ya know?</EnglishText>
      <Notes/>
      <SpeakerId>8</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>310016</PointerOffset>
      <VoiceId>&lt;audio:VSM_230_010_020&gt;</VoiceId>
      <JapaneseText>クルール？</JapaneseText>
      <EnglishText>Kururu~? </EnglishText>
      <Notes/>
      <SpeakerId>9</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
