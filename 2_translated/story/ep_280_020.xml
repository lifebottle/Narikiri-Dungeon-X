    <Entry>
      <PointerOffset>275580</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_020_014&gt;</VoiceId>
      <JapaneseText>クルール！！</JapaneseText>
      <EnglishText>Kuruuuru!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274880</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_020_003&gt;</VoiceId>
      <JapaneseText>貴様はぁ……我を……
我々を殺した……
たくさん殺した……</JapaneseText>
      <EnglishText>You have come here...to kill
us...You killed so many...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274968</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_020_004&gt;</VoiceId>
      <JapaneseText>な、何を言ってるの、
こいつ……！</JapaneseText>
      <EnglishText>What is it trying to say...!?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275052</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_020_005&gt;</VoiceId>
      <JapaneseText>戦わなきゃ、
ダメみたいだね……</JapaneseText>
      <EnglishText>Looks like we have no choice but to fight...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275128</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_020_006&gt;</VoiceId>
      <JapaneseText>ああ……。
来るぜ……！</JapaneseText>
      <EnglishText>Yes...It's coming...!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
