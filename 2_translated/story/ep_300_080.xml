    <Entry>
      <PointerOffset>275372</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_001&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275452</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_002&gt;</VoiceId>
      <JapaneseText>どうしたの？　&lt;Mel&gt;ちゃん</JapaneseText>
      <EnglishText>What's up, Melly?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275628</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_003&gt;</VoiceId>
      <JapaneseText>&lt;Rody&gt;さん、
やっぱりわたしたちのこと、
許せないですか？</JapaneseText>
      <EnglishText>You can't forgive us,
can you, Rondoline?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275628</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_004&gt;</VoiceId>
      <JapaneseText>ダオスをあんなにした原因、
わたしたちだし……</JapaneseText>
      <EnglishText>Since we're the reason
Dhaos became like that...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275688</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_005&gt;</VoiceId>
      <JapaneseText>許せない</JapaneseText>
      <EnglishText>"Nope. It's
unforgivable."</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275752</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_006&gt;</VoiceId>
      <JapaneseText>……ですよね</JapaneseText>
      <EnglishText>...Right?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275852</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_007&gt;</VoiceId>
      <JapaneseText>……って言ったら、一発、
殴らせてくれるのかな？</JapaneseText>
      <EnglishText>...If I really thought
that, would you let
me punch you?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>275920</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_008&gt;</VoiceId>
      <JapaneseText>ど、どうぞ……</JapaneseText>
      <EnglishText>S-Sure, go ahead...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276020</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_009&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;ちゃん、カワイイ。
食べちゃっていい？∀</JapaneseText>
      <EnglishText>Aww, Melly, you're so cute~
I could eat you right up! ∀</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276108</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_010&gt;</VoiceId>
      <JapaneseText>ちょ、ちょっと……
やめてください！</JapaneseText>
      <EnglishText>W-Wait... P-Please stop!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276380</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_011&gt;</VoiceId>
      <JapaneseText>フフっ……</JapaneseText>
      <EnglishText>Hehe...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>11</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276380</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_012&gt;</VoiceId>
      <JapaneseText>……そうだなぁ、
なんとも思ってない
わけないけど</JapaneseText>
      <EnglishText>...Well, I mean, of course I
have my own thoughts
and feelings about it...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>11</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276380</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_013&gt;</VoiceId>
      <JapaneseText>そもそも、君たちのやったことが
なければ、ダオスは
アセリアに来なかったし</JapaneseText>
      <EnglishText>But if you hadn't done it, Dhaos
wouldn't have come to Aselia
in the first place, you know?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>11</Id>
      <BubbleId>2</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276380</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_014&gt;</VoiceId>
      <JapaneseText>私がダオスに
会うこともなかった</JapaneseText>
      <EnglishText>So I would never
have met him.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>11</Id>
      <BubbleId>3</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276500</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_015&gt;</VoiceId>
      <JapaneseText>でも、そっちの方が
ダオスにも、&lt;Rody&gt;さんにも
幸せだったと思います</JapaneseText>
      <EnglishText>But, wouldn't you and
Dhaos both be happier
that way?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>15</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276668</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_016&gt;</VoiceId>
      <JapaneseText>私もそう思う</JapaneseText>
      <EnglishText>I think so, too.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>16</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276668</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_017&gt;</VoiceId>
      <JapaneseText>でも、つらくても、私はダオスに
会えなかった自分を想像できない
し、したくもないんだ</JapaneseText>
      <EnglishText>But, while it does hurt, I can't even
imagine what I'd be like if I hadn't
met him, and I don't want to, either.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>16</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276756</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_018&gt;</VoiceId>
      <JapaneseText>&lt;Rody&gt;さん、
そんなにダオスを……</JapaneseText>
      <EnglishText>That's how you feel
about him, &lt;Rondoline&gt;...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>18</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276936</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_019&gt;</VoiceId>
      <JapaneseText>それに君たちがあんなこと
した張本人だって言われても
ちょっとピンと来なくて</JapaneseText>
      <EnglishText>And even if I know you're the ones
responsible for all that stuff, I just
can't see you that way, you know?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>19</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>276936</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_020&gt;</VoiceId>
      <JapaneseText>見守らせて、
君たちの罪の行方、私に</JapaneseText>
      <EnglishText>So... Let me watch over
you, and the path your
sins lead you down.</EnglishText>
      <Notes>TL check</Notes>
      <SpeakerId>2</SpeakerId>
      <Id>19</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>277024</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_021&gt;</VoiceId>
      <JapaneseText>よろしくお願いします、
&lt;Rody&gt;さん</JapaneseText>
      <EnglishText>Please do,
&lt;Rondoline&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>21</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>277100</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_022&gt;</VoiceId>
      <JapaneseText>だーかーらー、固いってば</JapaneseText>
      <EnglishText>You still sound
soo~oo stiff!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>22</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>277180</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_023&gt;</VoiceId>
      <JapaneseText>……よろしくね……&lt;Rody&gt;</JapaneseText>
      <EnglishText>...Thanks...
&lt;Rody&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>23</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>277240</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_024&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>24</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>277304</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_025&gt;</VoiceId>
      <JapaneseText>クルール！</JapaneseText>
      <EnglishText>Couleuru!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>25</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>277384</PointerOffset>
      <VoiceId>&lt;audio:VSM_300_080_026&gt;</VoiceId>
      <JapaneseText>何やってんだ、
置いてくぞ！</JapaneseText>
      <EnglishText>What are you doing!?
We'll leave you behind!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>26</Id>
      <Status>Editing</Status>
    </Entry>
