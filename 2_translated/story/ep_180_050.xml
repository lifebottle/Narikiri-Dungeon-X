    <Entry>
      <PointerOffset>298652</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_001&gt;</VoiceId>
      <JapaneseText>きゃっ！</JapaneseText>
      <EnglishText>Gah!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298724</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_002&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;！　&lt;Mel&gt;！</JapaneseText>
      <EnglishText>&lt;Dio&gt;! &lt;Mel&gt;!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298788</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_003&gt;</VoiceId>
      <JapaneseText>クルール！</JapaneseText>
      <EnglishText>Kururu!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298856</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_004&gt;</VoiceId>
      <JapaneseText>なっ……なんだ！</JapaneseText>
      <EnglishText>Wh-What's wrong with y--!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298920</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_005&gt;</VoiceId>
      <JapaneseText>動くな！</JapaneseText>
      <EnglishText>Don't move!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299032</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_006&gt;</VoiceId>
      <JapaneseText>ここは我々が抑えました。
あなた方の好きにはさせません</JapaneseText>
      <EnglishText>We've finally got you. You won't
do as you please any longer.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299132</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_007&gt;</VoiceId>
      <JapaneseText>好きにさせないって……
どーゆーことだよ……！</JapaneseText>
      <EnglishText>Do as we please...? What
have we done to you...!?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299320</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_008&gt;</VoiceId>
      <JapaneseText>おとなしくしていれば、
危害は加えません</JapaneseText>
      <EnglishText>If you do as we say,
we won't hurt you.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>8</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299320</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_009&gt;</VoiceId>
      <JapaneseText>プルートの居場所、
吐いてもらいますよ</JapaneseText>
      <EnglishText>That is as long as you divulge
Pluto's whereabouts.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>8</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299320</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_010&gt;</VoiceId>
      <JapaneseText>連れていきなさい</JapaneseText>
      <EnglishText>Apprehend them.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>8</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299384</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_011&gt;</VoiceId>
      <JapaneseText>はっ！</JapaneseText>
      <EnglishText>Ha!</EnglishText>
      <Notes/>
      <SpeakerId>7</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299520</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_013&gt;</VoiceId>
      <JapaneseText>クルール！</JapaneseText>
      <EnglishText>Kuruuuru!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299456</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_012&gt;</VoiceId>
      <JapaneseText>おまえも来い！</JapaneseText>
      <EnglishText>You're coming too!</EnglishText>
      <Notes/>
      <SpeakerId>7</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299596</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_014&gt;</VoiceId>
      <JapaneseText>待てっ！　ふたりを返せ！</JapaneseText>
      <EnglishText>Wait! Let go of them!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299768</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_016&gt;</VoiceId>
      <JapaneseText>消えた……</JapaneseText>
      <EnglishText>They're gone...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>15</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299768</PointerOffset>
      <VoiceId>&lt;audio:VSM_180_050_017&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;……&lt;Mel&gt;……</JapaneseText>
      <EnglishText>&lt;Dio&gt;... &lt;Mel&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>15</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
