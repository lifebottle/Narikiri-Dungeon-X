  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>268116</PointerOffset>
      <VoiceId>&lt;audio:VSM_140_030_001&gt;</VoiceId>
      <JapaneseText>ゆっくり休めたかい、
君たち</JapaneseText>
      <EnglishText>I hope you slept well, everyone.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>268172</PointerOffset>
      <VoiceId>&lt;audio:VSM_140_030_002&gt;</VoiceId>
      <JapaneseText>ああ</JapaneseText>
      <EnglishText>We did.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>268752</PointerOffset>
      <VoiceId>&lt;audio:VSM_140_030_007&gt;</VoiceId>
      <JapaneseText>既に騎士団による鎮圧行動は
始まっている</JapaneseText>
      <EnglishText>The knights already left and have
the perimeter covered. The mission
to retake the town has begun.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>268752</PointerOffset>
      <VoiceId>&lt;audio:VSM_140_030_008&gt;</VoiceId>
      <JapaneseText>情勢が動けば、すぐに総攻撃に
入る予定になってる。
それまでに準備を整えておくこと</JapaneseText>
      <EnglishText>We will attack directly on
the frontlines. Until then,
prepare yourselves.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>268752</PointerOffset>
      <VoiceId>&lt;audio:VSM_140_030_009&gt;</VoiceId>
      <JapaneseText>準備が済んだら、
僕に声をかけて</JapaneseText>
      <EnglishText>Let me know whenever you're ready.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
  </Strings>
