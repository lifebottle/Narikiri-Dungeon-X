    <Section>Main</Section>
    <Entry>
      <PointerOffset>278140</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_001&gt;</VoiceId>
      <JapaneseText>わっ……また……</JapaneseText>
      <EnglishText>A-Again...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278216</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_002&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;、そこにいるの？</JapaneseText>
      <EnglishText>&lt;Mel&gt;...is that you there?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278276</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_003&gt;</VoiceId>
      <JapaneseText>エト！</JapaneseText>
      <EnglishText>Eto!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278364</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_004&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;も！？
真っ暗で見えないよ！</JapaneseText>
      <EnglishText>&lt;Dio&gt;, you're here too!? I-I can't
see a thing. It's all too dark...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278436</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_005&gt;</VoiceId>
      <JapaneseText>……シャドウですね？</JapaneseText>
      <EnglishText>...It is your doing, is it not, Shadow?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278496</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_006&gt;</VoiceId>
      <JapaneseText>何者</JapaneseText>
      <EnglishText>What...business...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278640</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_007&gt;</VoiceId>
      <JapaneseText>私は藤林&lt;Suzu&gt;と申します</JapaneseText>
      <EnglishText>I am Fujibayashi &lt;Suzu&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278640</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_008&gt;</VoiceId>
      <JapaneseText>以前、あなたと契約した
&lt;Klarth&gt;さんの知り合いです</JapaneseText>
      <EnglishText>Last time we met, I was one of
the companions of &lt;Klarth&gt;, the one
who formed a pact with you.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278712</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_009&gt;</VoiceId>
      <JapaneseText>我・知る・&lt;Klarth&gt;</JapaneseText>
      <EnglishText>I remember...&lt;Klarth&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>278960</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_012&gt;</VoiceId>
      <JapaneseText>解放してください、
私たちを、そして
あなたの中にいるもうひとりも</JapaneseText>
      <EnglishText>I ask of you to release us as
well as a companion of ours
that lies inside of you.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279108</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_014&gt;</VoiceId>
      <JapaneseText>領域・荒らす
許さない・封じる</JapaneseText>
      <EnglishText>The one...violates...this land...
Unforgivable... Must seal...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279208</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_015&gt;</VoiceId>
      <JapaneseText>テリトリーを荒らされて、
怒っているみたいです</JapaneseText>
      <EnglishText>It seems his anger stems from
our invasion into his territory.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279300</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_016&gt;</VoiceId>
      <JapaneseText>これってやっぱり
ノームの時と同じ……</JapaneseText>
      <EnglishText>This is exactly the same as Gnome...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279384</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_017&gt;</VoiceId>
      <JapaneseText>おまえたち・仲間・
許さない</JapaneseText>
      <EnglishText>Your friend...unforgivable...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>279720</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_070_021&gt;</VoiceId>
      <JapaneseText>来ます！</JapaneseText>
      <EnglishText>It's coming!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
