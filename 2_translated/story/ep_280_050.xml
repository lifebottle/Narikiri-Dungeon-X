    <Entry>
      <PointerOffset>274680</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_001&gt;</VoiceId>
      <JapaneseText>ここは、貴様に殺された
多くの魂が眠っている……</JapaneseText>
      <EnglishText>Here...lay the souls of the many
you bastards killed...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274680</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_002&gt;</VoiceId>
      <JapaneseText>我はその怨念の化身、残存思念</JapaneseText>
      <EnglishText>I am that hatred personified,
a lingering recollection.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274756</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_003&gt;</VoiceId>
      <JapaneseText>オレが……殺した……？</JapaneseText>
      <EnglishText>I...killed...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274824</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_004&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;、大丈夫？</JapaneseText>
      <EnglishText>&lt;Dio&gt;, are you ok...?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274900</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_005&gt;</VoiceId>
      <JapaneseText>また、何か見えたんだね？</JapaneseText>
      <EnglishText>What did you see this time?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275048</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_006&gt;</VoiceId>
      <JapaneseText>あれは……オレ自身……</JapaneseText>
      <EnglishText>I-I saw my father...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275048</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_007&gt;</VoiceId>
      <JapaneseText>……オレが……大人？
それってどーゆー……
うっ……！</JapaneseText>
      <EnglishText>But...I was an...adult?
How...how in the hell...?
Ugh!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275108</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_008&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;！</JapaneseText>
      <EnglishText>&lt;Dio&gt;!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275176</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_009&gt;</VoiceId>
      <JapaneseText>しっかりして！</JapaneseText>
      <EnglishText>Hang in there!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275296</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_010&gt;</VoiceId>
      <JapaneseText>はぁはぁ……</JapaneseText>
      <EnglishText>Hah...Hah...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275296</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_011&gt;</VoiceId>
      <JapaneseText>全然……
だいじょーぶだっての……！</JapaneseText>
      <EnglishText>No...problem...at all...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275360</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_012&gt;</VoiceId>
      <JapaneseText>あれは……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>275452</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_013&gt;</VoiceId>
      <JapaneseText>わたしたちの因縁が
眠ってるの、あそこに</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>275524</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_014&gt;</VoiceId>
      <JapaneseText>そうだな、
行こうぜ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>275588</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_015&gt;</VoiceId>
      <JapaneseText>行こうぜ……</JapaneseText>
      <EnglishText>Let's go.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275648</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_016&gt;</VoiceId>
      <JapaneseText>どこへ？</JapaneseText>
      <EnglishText>Where to?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275772</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_017&gt;</VoiceId>
      <JapaneseText>&lt;Red&gt;ロキ魔科学研究窟&lt;White&gt;
ってとこ</JapaneseText>
      <EnglishText>To &lt;Red&gt;Loki Research Center Cavern&lt;White&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275772</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_018&gt;</VoiceId>
      <JapaneseText>ここからずっと南西の方だ</JapaneseText>
      <EnglishText>It's southwest from here.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275848</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_019&gt;</VoiceId>
      <JapaneseText>そこに何が……あるの？</JapaneseText>
      <EnglishText>And what will...there be?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>19</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>275952</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_020&gt;</VoiceId>
      <JapaneseText>わかんね……でも、
何かがそこにいる、
そう言ってた</JapaneseText>
      <EnglishText>I dunno...but, I'm just sure
there's something out there.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>20</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276092</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_022&gt;</VoiceId>
      <JapaneseText>それじゃあ……
行こう</JapaneseText>
      <EnglishText>Then we do have to go. Let's move.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>21</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>276156</PointerOffset>
      <VoiceId>&lt;audio:VSM_280_050_023&gt;</VoiceId>
      <JapaneseText>う、うん……</JapaneseText>
      <EnglishText>Y-Yeah...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>22</Id>
      <Status>Proofreading</Status>
    </Entry>
