    <Section>Main</Section>
    <Entry>
      <PointerOffset>270204</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_001&gt;</VoiceId>
      <JapaneseText>デリス……カーラーン……</JapaneseText>
      <EnglishText>...Derris...Kharlan...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270296</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_002&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;！　しっかりしろ！
どーしたんだ！</JapaneseText>
      <EnglishText>&lt;Mel&gt;! Hang in there! What's going on!?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270452</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_003&gt;</VoiceId>
      <JapaneseText>え……？
あ……今のは……</JapaneseText>
      <EnglishText>Huh....? What just...happened?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270452</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_004&gt;</VoiceId>
      <JapaneseText>わたし……？　じゃない……
でも、わたし、何か知ってる……</JapaneseText>
      <EnglishText>That...wasn't me? But....those...were
definitely my own memories...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270620</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_006&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;、大丈夫？
なんか疲れてるみたい……</JapaneseText>
      <EnglishText>&lt;Mel&gt;, are you feeling alright?
You look a bit pale...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270692</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_007&gt;</VoiceId>
      <JapaneseText>うん、平気平気……</JapaneseText>
      <EnglishText>I'm fine, I'm fine...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270792</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_008&gt;</VoiceId>
      <JapaneseText>あんにゃろー！
&lt;Mel&gt;に変なのぶつけやがって！</JapaneseText>
      <EnglishText>Those jerks! I'll beat them
up for doing that to you!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270896</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_009&gt;</VoiceId>
      <JapaneseText>やっぱり&lt;Red&gt;氷狼王の礎&lt;White&gt;って
とこに行ったのかな……？</JapaneseText>
      <EnglishText>So...we're going to the &lt;Red&gt;Cornerstone
of the Ice Wolf&lt;White&gt; after all...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>270968</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_090_010&gt;</VoiceId>
      <JapaneseText>だろうな……行こうぜ</JapaneseText>
      <EnglishText>Yeah. Come on!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
