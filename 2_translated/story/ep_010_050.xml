    <Entry>
      <PointerOffset>270924</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_001&gt;</VoiceId>
      <JapaneseText>よしっ……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271000</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_002&gt;</VoiceId>
      <JapaneseText>……何が『よし』なの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271068</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_003&gt;</VoiceId>
      <JapaneseText>な、なんでもない</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271148</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_004&gt;</VoiceId>
      <JapaneseText>今日もキレイに
咲いてるね♪</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271232</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_005&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;が南の浜で
摘んできた花？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271392</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_006&gt;</VoiceId>
      <JapaneseText>そう。寂しかった食卓が
明るくなったよ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <BubbleId>0</BubbleId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271392</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_007&gt;</VoiceId>
      <JapaneseText>ありがと、&lt;Dio&gt;。
テーブルの花、
取ってきてくれて</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <BubbleId>1</BubbleId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271472</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_008&gt;</VoiceId>
      <JapaneseText>べ、別に
そんなんじゃねって</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271532</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_009&gt;</VoiceId>
      <JapaneseText>そう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271596</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_010&gt;</VoiceId>
      <JapaneseText>ふーん……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271668</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_011&gt;</VoiceId>
      <JapaneseText>な、なんだよ……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>271744</PointerOffset>
      <VoiceId>&lt;audio:VSM_010_050_012&gt;</VoiceId>
      <JapaneseText>なんでもない。さ、行こ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
