    <Section>Main</Section>
    <Entry>
      <PointerOffset>273772</PointerOffset>
      <JapaneseText>あ、そう言えば、
この腕輪、さっき拾ったんだけド……</JapaneseText>
      <EnglishText>Oh, I just remembered...
I picked up this bracelet
just a little while ago...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273828</PointerOffset>
      <JapaneseText>何……かな、この腕輪？</JapaneseText>
      <EnglishText>What's it for...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273900</PointerOffset>
      <JapaneseText>へんな出っぱり、
これって飾りかな？</JapaneseText>
      <EnglishText>Well, there's this weird part
that sticks out... Maybe it's
some kind of jewelry...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>273948</PointerOffset>
      <JapaneseText>ちょっといいか</JapaneseText>
      <EnglishText>Can I borrow
it for a sec?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274000</PointerOffset>
      <JapaneseText>こう、手につけてさ</JapaneseText>
      <EnglishText>Okay, just put it on
your arm like this, then...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274088</PointerOffset>
      <JapaneseText>なりきりクロスシフトっ！
ってやるとかっこよくない？</JapaneseText>
      <EnglishText>Roleplay, Cross Shift!
...Kinda cool, right?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274140</PointerOffset>
      <JapaneseText>かっこよくない！</JapaneseText>
      <EnglishText>Not cool at all!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274184</PointerOffset>
      <JapaneseText>クルール！</JapaneseText>
      <EnglishText>Couleuru!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274244</PointerOffset>
      <JapaneseText>あっ……
&lt;Couleur&gt;待って……</JapaneseText>
      <EnglishText>Ah... Wait,
&lt;Couleur&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>274296</PointerOffset>
      <JapaneseText>オレたちも行くぞ！</JapaneseText>
      <EnglishText>Let's go after him!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
