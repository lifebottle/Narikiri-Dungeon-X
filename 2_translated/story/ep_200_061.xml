    <Section>Main</Section>
    <Entry>
      <PointerOffset>297052</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_009&gt;</VoiceId>
      <JapaneseText>▼☆○◆～～～</JapaneseText>
      <EnglishText>▼☆○◆〜〜〜 </EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297152</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_010&gt;</VoiceId>
      <JapaneseText>ヴォルト！
オレらに“電気”の
力を分けてくれ！</JapaneseText>
      <EnglishText>Volt! Please give us the
power of "electricity"!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297216</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_011&gt;</VoiceId>
      <JapaneseText>※★☆●～</JapaneseText>
      <EnglishText>※★☆●〜 </EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297276</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_012&gt;</VoiceId>
      <JapaneseText>あっ……</JapaneseText>
      <EnglishText>Whoa...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297352</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_013&gt;</VoiceId>
      <JapaneseText>◎×※※★□▼＄☆……</JapaneseText>
      <EnglishText>◎×※※★□▼＄☆...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297444</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_014&gt;</VoiceId>
      <JapaneseText>え……南の……方の
精霊が騒がしい……？</JapaneseText>
      <EnglishText>Huh? Search for...the Spirit...south from here?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297516</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_015&gt;</VoiceId>
      <JapaneseText>ん？　どういうこと？</JapaneseText>
      <EnglishText>Hmm? Is something wrong?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297636</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_016&gt;</VoiceId>
      <JapaneseText>さあ、それは……。
でも、ヴォルトの言ってる言葉が
わかるみたいで……</JapaneseText>
      <EnglishText>That's what it...it's nothing. I mean it
seems no one understood it, anyways...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297728</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_017&gt;</VoiceId>
      <JapaneseText>精霊晶核もらったことと
関係あんのか？</JapaneseText>
      <EnglishText>Maybe you could understand him since
he gave us the Atomism Core?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297800</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_018&gt;</VoiceId>
      <JapaneseText>☆☆☆◎★★※▲</JapaneseText>
      <EnglishText>☆☆☆◎★★※▲ </EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297912</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_019&gt;</VoiceId>
      <JapaneseText>えっと……その騒ぎのせいで、
わたしたちを襲った……って……</JapaneseText>
      <EnglishText>It's because of a disturbance...
that he attacked us...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297984</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_020&gt;</VoiceId>
      <JapaneseText>精霊が、騒がしい……</JapaneseText>
      <EnglishText>The Spirits are...disturbed...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298084</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_021&gt;</VoiceId>
      <JapaneseText>もしかして、
そこにエトちゃんがいる、
とか！？</JapaneseText>
      <EnglishText>You don't think that...
Miss Eto could be there!?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298164</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_022&gt;</VoiceId>
      <JapaneseText>そう言えば
ノームの時も……</JapaneseText>
      <EnglishText>That's right. Gnome said he
was disturbed as well...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298256</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_023&gt;</VoiceId>
      <JapaneseText>それだよ……！
きっとそこにエトがいる！</JapaneseText>
      <EnglishText>That's it! She must be there!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298348</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_024&gt;</VoiceId>
      <JapaneseText>ここから
南の大陸と言えば
アーリィですね</JapaneseText>
      <EnglishText>South from here lies the continent of Arlee.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298456</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_025&gt;</VoiceId>
      <JapaneseText>行ってみよーぜ！</JapaneseText>
      <EnglishText>Let's go look!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298456</PointerOffset>
      <VoiceId>&lt;audio:VSM_200_060_026&gt;</VoiceId>
      <JapaneseText>サンキュ、ヴォルト</JapaneseText>
      <EnglishText>Thanks a bunch, Volt!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>17</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
