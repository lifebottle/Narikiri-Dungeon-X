    <Section>Main</Section>
    <Entry>
      <PointerOffset>282244</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_001&gt;</VoiceId>
      <JapaneseText>これは国王陛下直筆の……
どうぞ、お通りください</JapaneseText>
      <EnglishText>Is that a pass from the King...!?
Please go on ahead!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282304</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_002&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282364</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_003&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282464</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_004&gt;</VoiceId>
      <JapaneseText>仲良きことは美しきかな、
ほら、笑っとこうぜ？</JapaneseText>
      <EnglishText>It's so beautiful how well you two get along!
C'mon, look alive and smile!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <Status>Problematic</Status>
    </Entry>
    <Entry>
      <PointerOffset>282548</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_005&gt;</VoiceId>
      <JapaneseText>ねぇ妖精さん、
あのふたり平気？</JapaneseText>
      <EnglishText>Hey Miss Fairy. Are these two ok?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282708</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_006&gt;</VoiceId>
      <JapaneseText>え？　ああ……
いつものことだシ……</JapaneseText>
      <EnglishText>Oh? Yeah, this always happens...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>6</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282708</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_007&gt;</VoiceId>
      <JapaneseText>ほっといたら、いつの間にか、
仲直りしてるもの、いつも</JapaneseText>
      <EnglishText>If you leave them alone, they always reconcile.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>6</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282780</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_008&gt;</VoiceId>
      <JapaneseText>そういうもん、なの？</JapaneseText>
      <EnglishText>Just like that?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>282880</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_009&gt;</VoiceId>
      <JapaneseText>まぁ、君は、彼らに対して
少し過保護すぎるからな</JapaneseText>
      <EnglishText>Haven't you considered you might be overprotective?</EnglishText>
      <Notes>Is overprotective the right word? We think it might be coddling </Notes>
      <SpeakerId>6</SpeakerId>
      <Id>9</Id>
      <Status>Problematic</Status>
    </Entry>
    <Entry>
      <PointerOffset>283364</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_015&gt;</VoiceId>
      <JapaneseText>そう、でもないけド……</JapaneseText>
      <EnglishText>I...don't think so, but...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>283452</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_016&gt;</VoiceId>
      <JapaneseText>ちょっと、&lt;Dio&gt;、
どこ行くの！？</JapaneseText>
      <EnglishText>Hey, &lt;Dio&gt;! Where are you going!?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>283520</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_017&gt;</VoiceId>
      <JapaneseText>ここは左だろ！</JapaneseText>
      <EnglishText>Let's turn left here!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>283620</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_018&gt;</VoiceId>
      <JapaneseText>右だよ、だって
そっちはなんか
ダメな感じするし</JapaneseText>
      <EnglishText>No, let's turn right. I think there's a dead end that way.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>283688</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_019&gt;</VoiceId>
      <JapaneseText>……ねぇ、エト</JapaneseText>
      <EnglishText>What do you think, Eto?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>283760</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_020&gt;</VoiceId>
      <JapaneseText>あ～、はいはい……</JapaneseText>
      <EnglishText>Ah... Right, right...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>283848</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_021&gt;</VoiceId>
      <JapaneseText>ふふっ……
やっぱり過保護さんだよね</JapaneseText>
      <EnglishText>Hehehe...! She IS overprotective!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>16</Id>
      <Status>Problematic</Status>
    </Entry>
    <Entry>
      <PointerOffset>283908</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_010_022&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
