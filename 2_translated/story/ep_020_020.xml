    <Entry>
      <PointerOffset>280097</PointerOffset>
      <JapaneseText>買い物の仕方を聞きますか？</JapaneseText>
      <EnglishText>Hear the item buying tutorial?</EnglishText>
      <Notes/>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
