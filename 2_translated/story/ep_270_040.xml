      <VoiceId>&lt;audio:VSM_270_040_001&gt;</VoiceId>
      <JapaneseText>遅かった……！？</JapaneseText>
      <EnglishText>Are we too late...!?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
