      <JapaneseText>ああ……少しだけな</JapaneseText>
      <EnglishText>Yes, but only by a hair.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>274400</PointerOffset>
