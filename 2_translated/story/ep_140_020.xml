    <Entry>
      <PointerOffset>281384</PointerOffset>
      <VoiceId>&lt;audio:VSM_140_020_047&gt;</VoiceId>
      <JapaneseText>もう夜も遅い。
テントに戻って休むんだ</JapaneseText>
      <EnglishText>It's already pretty late. You
should get back to your
tent and get some sleep.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>46</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>281384</PointerOffset>
      <VoiceId>&lt;audio:VSM_140_020_048&gt;</VoiceId>
      <JapaneseText>起きられなかったら、
置いていくよ</JapaneseText>
      <EnglishText>If you don't get up
in the morning, we'll
leave you behind.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>46</Id>
