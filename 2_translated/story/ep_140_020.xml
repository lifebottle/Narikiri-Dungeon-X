    <Entry>
      <PointerOffset>281384</PointerOffset>
      <VoiceId>&lt;audio:VSM_140_020_046&gt;</VoiceId>
      <JapaneseText>……さあ、
話はこれくらいにして</JapaneseText>
      <EnglishText>...Well, let's
leave it there.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>46</Id>
