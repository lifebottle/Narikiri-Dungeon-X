      <PointerOffset>277012</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_001&gt;</VoiceId>
      <JapaneseText>……何並んでんだ、これ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>277116</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_002&gt;</VoiceId>
      <JapaneseText>あら？　ボクちゃんたち、
横入りはダメよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>277192</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_003&gt;</VoiceId>
      <JapaneseText>これ、何の列なんですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>277296</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_004&gt;</VoiceId>
      <JapaneseText>&lt;Mint&gt;様に診察してもらう
順番を待ってるのよ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>277376</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_005&gt;</VoiceId>
      <JapaneseText>&lt;Mint&gt;って……
時空戦士の？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>277472</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_006&gt;</VoiceId>
      <JapaneseText>そうよ。
ここが最後尾。
９時間待ち</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>277540</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_007&gt;</VoiceId>
      <JapaneseText>く、９時間！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>278392</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_017&gt;</VoiceId>
      <JapaneseText>&lt;Mint&gt;は時空戦士の法術師で、
結社を作って、
世界に法術を広めた人なんだ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>278456</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_018&gt;</VoiceId>
      <JapaneseText>詳しいんだね</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>278540</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_019&gt;</VoiceId>
      <JapaneseText>今は&lt;Cless&gt;さんに
会うんでしょ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>278612</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_020&gt;</VoiceId>
      <JapaneseText>あ、そうだった……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>278716</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_021&gt;</VoiceId>
      <JapaneseText>あら？　道場の入門者なの、
ボクちゃんたち</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>278788</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_030_022&gt;</VoiceId>
      <JapaneseText>え？　いや、あの……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>278900</PointerOffset>
