    <Section>Main</Section>
    <Entry>
      <PointerOffset>294716</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_001&gt;</VoiceId>
      <JapaneseText>きゃっ！！</JapaneseText>
      <EnglishText>Ahh!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>294784</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_002&gt;</VoiceId>
      <JapaneseText>……アミィ！！</JapaneseText>
      <EnglishText>Ami!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>294860</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_003&gt;</VoiceId>
      <JapaneseText>あ、ありがとうございます</JapaneseText>
      <EnglishText>Th-Thank you kindly!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>294980</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_004&gt;</VoiceId>
      <JapaneseText>ははっ、悪い、
名前、違ってたな</JapaneseText>
      <EnglishText>Huh? A-hahaha... That's no good.
That's not your name.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>294980</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_005&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;、だったよな</JapaneseText>
      <EnglishText>You're &lt;Mel&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>295044</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_006&gt;</VoiceId>
      <JapaneseText>い、いえ……</JapaneseText>
      <EnglishText>I-It's alright...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>295264</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_009&gt;</VoiceId>
      <JapaneseText>下がってな。
オレが片付けてやる</JapaneseText>
      <EnglishText>Let's fall back, there are
too many of them.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>295352</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_010&gt;</VoiceId>
      <JapaneseText>オレらだって、
けっこーやれるぜ？</JapaneseText>
      <EnglishText>I can do this! I can handle
them all by myself!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>295432</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_011&gt;</VoiceId>
      <JapaneseText>じゃあ、
見せてもらおうか</JapaneseText>
      <EnglishText>Okay, show me what you can do.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>295568</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_010_013&gt;</VoiceId>
      <JapaneseText>おうっ！</JapaneseText>
      <EnglishText>Yeah! </EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
