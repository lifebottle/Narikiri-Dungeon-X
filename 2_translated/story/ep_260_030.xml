    <Section>Main</Section>
    <Entry>
      <PointerOffset>271076</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_030_001&gt;</VoiceId>
      <JapaneseText>ここが&lt;Red&gt;焔王の楔&lt;White&gt;……
みたいだな</JapaneseText>
      <EnglishText>So this is the &lt;Red&gt;Linchpin of
the Lord of Fire&lt;White&gt;, right?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271168</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_030_002&gt;</VoiceId>
      <JapaneseText>ここにあの人たちが……？
でも何で……</JapaneseText>
      <EnglishText>Those two are here, right?
But...why?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271272</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_030_003&gt;</VoiceId>
      <JapaneseText>追いかけよーぜ、
捕まえて問いつめて、
それから……</JapaneseText>
      <EnglishText>Let's catch them first,
ask the questions later,
and then...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271344</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_030_004&gt;</VoiceId>
      <JapaneseText>ぶん殴る、でしょ？</JapaneseText>
      <EnglishText>...We beat the daylights
out of them! Right?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271424</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_030_005&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;、&lt;Dio&gt;のまねしないの</JapaneseText>
      <EnglishText>&lt;Mel&gt; please don't
start copying &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271488</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_030_006&gt;</VoiceId>
      <JapaneseText>うふふ……</JapaneseText>
      <EnglishText>Hehehe.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271560</PointerOffset>
      <VoiceId>&lt;audio:VSM_260_030_007&gt;</VoiceId>
      <JapaneseText>おしっ……行くぞ！</JapaneseText>
      <EnglishText>Ok, let's get to it!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
