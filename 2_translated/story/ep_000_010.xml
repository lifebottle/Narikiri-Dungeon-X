    <Section>Main</Section>
    <Entry>
      <PointerOffset>269972</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_001&gt;</VoiceId>
      <JapaneseText>……ここ……
どこだろう……</JapaneseText>
      <EnglishText>...Where...
am I...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270204</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_003&gt;</VoiceId>
      <JapaneseText>もう何年経ったかな……</JapaneseText>
      <EnglishText>How many years
have passed...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270204</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_004&gt;</VoiceId>
      <JapaneseText>後、何年続けたら仲間の妖精が
見つかるんだろ……</JapaneseText>
      <EnglishText>And how many years will I have to
look, before I find my friends?
Before I find other fairies, like me...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270296</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_005&gt;</VoiceId>
      <JapaneseText>何年続けたって……
……だめ、だ……</JapaneseText>
      <EnglishText>No... However many years I
search, I'll never...find them...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270416</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_006&gt;</VoiceId>
      <JapaneseText>はぁ……</JapaneseText>
      <EnglishText>Haaah...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270416</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_007&gt;</VoiceId>
      <JapaneseText>ここでぼく、
終わっちゃうんだな……</JapaneseText>
      <EnglishText>I guess this is...
the end...for me...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270568</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_009&gt;</VoiceId>
      <JapaneseText>……流れ、星……？</JapaneseText>
      <EnglishText>...A shooting...star...?</EnglishText>
      <Notes>Isn't used in-game.</Notes>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270700</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_010&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <BubbleId>0</BubbleId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>270700</PointerOffset>
      <VoiceId>&lt;audio:VSM_000_010_011&gt;</VoiceId>
      <JapaneseText>……願いごと……
叶うなラ……
……仲間、に……</JapaneseText>
      <EnglishText>...If you can grant...
one wish, then...
I want...my friends...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <BubbleId>1</BubbleId>
      <Status>Editing</Status>
    </Entry>
