  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>271864</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_001&gt;</VoiceId>
      <JapaneseText>ここは……？</JapaneseText>
      <EnglishText>Where are we...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271936</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_002&gt;</VoiceId>
      <JapaneseText>なにか書いてあるよ？</JapaneseText>
      <EnglishText>Is there something written there?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272012</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_003&gt;</VoiceId>
      <JapaneseText>なんだこれ。何語なんだ？</JapaneseText>
      <EnglishText>What kind of language is this?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272084</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_004&gt;</VoiceId>
      <JapaneseText>ちょっと読めないな</JapaneseText>
      <EnglishText>Can't read it at all.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272148</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_005&gt;</VoiceId>
      <JapaneseText>クルールゥ～</JapaneseText>
      <EnglishText>Kuruuuuruuu...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272248</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_006&gt;</VoiceId>
      <JapaneseText>死を暗示する方位には、
破壊を司る者を招くがよい</JapaneseText>
      <EnglishText>Give name to the bringer of destruction
in the path death lurks.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272312</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_007&gt;</VoiceId>
      <JapaneseText>読めるのか？</JapaneseText>
      <EnglishText>You can read it?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272396</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_008&gt;</VoiceId>
      <JapaneseText>う、うん……
読める、みたい……</JapaneseText>
      <EnglishText>Y-Yeah...Somehow I can read it...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272516</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_009&gt;</VoiceId>
      <JapaneseText>なんで……</JapaneseText>
      <EnglishText>How...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272516</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_010&gt;</VoiceId>
      <JapaneseText>いや、とにかく。
何て書いてあるんだ？</JapaneseText>
      <EnglishText>No matter. In any case what's written there?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272864</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_011&gt;</VoiceId>
      <JapaneseText>えっと……</JapaneseText>
      <EnglishText>Let's see...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272864</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_012&gt;</VoiceId>
      <JapaneseText>死を暗示する方位には、
破壊を司る者を招くがよい</JapaneseText>
      <EnglishText>Give name to the bringer of destruction
in the path death lurks.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272864</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_013&gt;</VoiceId>
      <JapaneseText>生命の息吹を感じたなら、
そこは誕生の司る者の場所である</JapaneseText>
      <EnglishText>The Spirit that rules over life shall
lie where life's breath can be felt.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272864</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_014&gt;</VoiceId>
      <JapaneseText>逝く者に涙する乙女は
死を左手に感ずる者に招かれよ</JapaneseText>
      <EnglishText>A maiden that weeps over those
that death has claimed lies west.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <BubbleId>3</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272864</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_015&gt;</VoiceId>
      <JapaneseText>風は乙女と向かい、
時の流れのように等しく
みなに吹き抜ける</JapaneseText>
      <EnglishText>Wind faces the maiden, blowing in the
direction dictated by the flow of time.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <BubbleId>4</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272968</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_016&gt;</VoiceId>
      <JapaneseText>方位とか、司るとか、
招くとか、どういう意味なんだ？</JapaneseText>
      <EnglishText>Path death lurks, rules over life, give
name? What does this all mean?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273064</PointerOffset>
      <VoiceId>&lt;audio:VSM_120_040_017&gt;</VoiceId>
      <JapaneseText>司る……？
精霊は水を司るとか、
ゆーよな……</JapaneseText>
      <EnglishText>Rules life...? Well, that sounds like
the Water Summon Spirit...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
