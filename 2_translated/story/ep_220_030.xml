    <Section>Main</Section>
    <Entry>
      <PointerOffset>271040</PointerOffset>
      <VoiceId>&lt;audio:VSM_220_030_001&gt;</VoiceId>
      <JapaneseText>くっ……こ、これ何だ……？</JapaneseText>
      <EnglishText>Wh-What IS this!?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271104</PointerOffset>
      <VoiceId>&lt;audio:VSM_220_030_002&gt;</VoiceId>
      <JapaneseText>瘴気だ……！</JapaneseText>
      <EnglishText>It's Miasma...!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271176</PointerOffset>
      <VoiceId>&lt;audio:VSM_220_030_003&gt;</VoiceId>
      <JapaneseText>クル～クル～……！</JapaneseText>
      <EnglishText>Kuru~ Kuru~...!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271284</PointerOffset>
      <VoiceId>&lt;audio:VSM_220_030_004&gt;</VoiceId>
      <JapaneseText>こいつはやばいな……！
少しくらいなら
進めそうだが……</JapaneseText>
      <EnglishText>This is bad! We've just started
and yet we can't advance...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>271384</PointerOffset>
      <VoiceId>&lt;audio:VSM_220_030_005&gt;</VoiceId>
      <JapaneseText>危険です……！
一旦、退いた方が
いいと思います！</JapaneseText>
      <EnglishText>It's too dangerous! It would be best
to retreat for now, I believe!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
