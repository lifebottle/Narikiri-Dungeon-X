    <Entry>
      <PointerOffset>296752</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_001&gt;</VoiceId>
      <JapaneseText>うわっ……！
なに……！？</JapaneseText>
      <EnglishText>Wow! What was that!?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296856</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_002&gt;</VoiceId>
      <JapaneseText>君たちのおかげで
いい感じにマナが
蓄積されたみたい</JapaneseText>
      <EnglishText>Thanks to your help, it seems I was able
to gather a good amount of Mana.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>296920</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_003&gt;</VoiceId>
      <JapaneseText>マナ……！？</JapaneseText>
      <EnglishText>What!? Mana!?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297120</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_004&gt;</VoiceId>
      <JapaneseText>精霊さんからは大量に漏れ出る
余剰マナがあるんだ</JapaneseText>
      <EnglishText>You see, Spirits emit large quantities of residual Mana.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297120</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_005&gt;</VoiceId>
      <JapaneseText>そのマナがいっぱいになると
この指輪が力を発揮する</JapaneseText>
      <EnglishText>That Mana manifests into energy for my ring.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297120</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_006&gt;</VoiceId>
      <JapaneseText>時間転移のね</JapaneseText>
      <EnglishText>With enough energy, it can time travel.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297200</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_007&gt;</VoiceId>
      <JapaneseText>待て！
どこへ行くつもりだ！</JapaneseText>
      <EnglishText>Wait a second! Where do you plan to go!?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297268</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_008&gt;</VoiceId>
      <JapaneseText>ダオスのところ</JapaneseText>
      <EnglishText>Wherever Dhaos is.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297584</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_012&gt;</VoiceId>
      <JapaneseText>待て、&lt;Rody&gt;！</JapaneseText>
      <EnglishText>Wait, Rody!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297648</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_013&gt;</VoiceId>
      <JapaneseText>くっ……！</JapaneseText>
      <EnglishText>Ugh...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297812</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_015&gt;</VoiceId>
      <JapaneseText>ダオスって……
&lt;Klarth&gt;さんたちが
倒したんだろ？</JapaneseText>
      <EnglishText>Dhaos...? Didn't &lt;Klarth&gt; and the others defeat him?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298008</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_016&gt;</VoiceId>
      <JapaneseText>ああ。だが彼女は
自分の手でダオスを
倒したいと思ってる</JapaneseText>
      <EnglishText>Right, but she wants to defeat
Dhaos with her own two hands.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>12</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298008</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_017&gt;</VoiceId>
      <JapaneseText>ダオスと戦うため……
彼女は再びダオスがいる
時間へと旅立ったのだろう</JapaneseText>
      <EnglishText>She wants to defeat Dhaos so badly that...
she'd once again travel to a period where
Dhaos is alive to accomplish her mission.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>12</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298080</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_018&gt;</VoiceId>
      <JapaneseText>でも、どうして……</JapaneseText>
      <EnglishText>But...why would she go through all of that?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298204</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_019&gt;</VoiceId>
      <JapaneseText>&lt;Rody&gt;も、みんなと一緒で
世界を守るために
戦いたかったんじゃねーのか？</JapaneseText>
      <EnglishText>Didn't Rody, along with everyone else,
fight to protect the world?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298344</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_020&gt;</VoiceId>
      <JapaneseText>世界を守るか……</JapaneseText>
      <EnglishText>Did we really protect the world...?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>16</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298344</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_021&gt;</VoiceId>
      <JapaneseText>……本当にこのアセリアを
守ったのは誰だったんだろうな</JapaneseText>
      <EnglishText>...I wonder who the one protecting Aselia was.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>16</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298520</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_022&gt;</VoiceId>
      <JapaneseText>いや……</JapaneseText>
      <EnglishText>No matter...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>18</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298520</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_023&gt;</VoiceId>
      <JapaneseText>さて、ここでお別れだ</JapaneseText>
      <EnglishText>Regardless, this is where we part ways.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>18</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298520</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_024&gt;</VoiceId>
      <JapaneseText>君たちには君たちの
やらなければならないことが
あるだろう？</JapaneseText>
      <EnglishText>You guys have your own important matters
to deal with right now, and so do I.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>18</Id>
      <BubbleId>2</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298600</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_025&gt;</VoiceId>
      <JapaneseText>そうだな。
&lt;Mel&gt;……帰ろう</JapaneseText>
      <EnglishText>You're right. &lt;Mel&gt;...Let's go back!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>21</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298676</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_026&gt;</VoiceId>
      <JapaneseText>うん。わたしたちの時代に</JapaneseText>
      <EnglishText>Yes! Let's go back to our time!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>22</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298736</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_027&gt;</VoiceId>
      <JapaneseText>じゃあな</JapaneseText>
      <EnglishText>Goodbye, then.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>23</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298812</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_028&gt;</VoiceId>
      <JapaneseText>うん。また、会えるかな？</JapaneseText>
      <EnglishText>Yes! Until...next time?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>24</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298904</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_029&gt;</VoiceId>
      <JapaneseText>さぁ。だが……
機会があればたぶん、な</JapaneseText>
      <EnglishText>Yes... Let's yearn for another opportunity.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>25</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298992</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_030&gt;</VoiceId>
      <JapaneseText>いろいろ、
ありがとうございました</JapaneseText>
      <EnglishText>Really, thank you very much!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>26</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>299048</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_040_031&gt;</VoiceId>
      <JapaneseText>ああ</JapaneseText>
      <EnglishText>Thank you too.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>27</Id>
      <Status>Proofreading</Status>
    </Entry>
