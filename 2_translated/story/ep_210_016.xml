    <Section>Main</Section>
    <Entry>
      <PointerOffset>272740</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_039&gt;</VoiceId>
      <JapaneseText>クルール～……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>272812</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_040&gt;</VoiceId>
      <JapaneseText>一体、何だったんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>273100</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_041&gt;</VoiceId>
      <JapaneseText>よくはわかりませんが……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <BubbleId>0</BubbleId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>273100</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_042&gt;</VoiceId>
      <JapaneseText>動物と意思疎通できるという
この道具の特性が、&lt;Couleur&gt;さんの
持つ何かに反応した、としか</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>273100</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_043&gt;</VoiceId>
      <JapaneseText>あるいは、ずっと&lt;Couleur&gt;さんと
旅してきたおふたりだからこそ、
その姿になれるのかもしれません</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <BubbleId>2</BubbleId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>273180</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_044&gt;</VoiceId>
      <JapaneseText>不思議なこともあるもんだね</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>273272</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_045&gt;</VoiceId>
      <JapaneseText>おまえ、本当、一体、
なにもんなんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>273336</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_046&gt;</VoiceId>
      <JapaneseText>クルール？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>273552</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_047&gt;</VoiceId>
      <JapaneseText>おめぇら、ええか？
チェインパートナーの時は
魔物の捕獲はできねーだど</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>9</Id>
      <BubbleId>0</BubbleId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>273552</PointerOffset>
      <VoiceId>&lt;audio:VSM_210_015_048&gt;</VoiceId>
      <JapaneseText>詳しくはいつも通り、
バトルメモを穴が開くほど
じーっと見るとええだーよ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>9</Id>
      <BubbleId>1</BubbleId>
      <Status>To Do</Status>
    </Entry>
