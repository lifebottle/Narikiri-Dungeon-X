    <Section>Main</Section>
    <Entry>
      <PointerOffset>268992</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_001&gt;</VoiceId>
      <JapaneseText>ここって……
&lt;Cless&gt;さんの道場だよね？</JapaneseText>
      <EnglishText>Here? Isn't this Mister &lt;Cless&gt;'s Dojo?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269080</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_002&gt;</VoiceId>
      <JapaneseText>じゃ……あんたが……
&lt;Cless&gt;さん！？</JapaneseText>
      <EnglishText>Then... YOU'RE Mister &lt;Cless&gt;!?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269228</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_003&gt;</VoiceId>
      <JapaneseText>オレが？
ははっ、違うって</JapaneseText>
      <EnglishText>Who, me? Hahahaha, no I'm not.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269228</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_004&gt;</VoiceId>
      <JapaneseText>オレは&lt;Chester&gt;・バークライト。
&lt;Cless&gt;の幼馴染だ</JapaneseText>
      <EnglishText>My name's &lt;Chester&gt; Barklight, I'm
one of &lt;Cless&gt;'s childhood friends.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269348</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_005&gt;</VoiceId>
      <JapaneseText>&lt;Chester&gt;……って……</JapaneseText>
      <EnglishText>&lt;Chester&gt;... You...don't say...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269348</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_006&gt;</VoiceId>
      <JapaneseText>じゃあ、あんたも
時空戦士！？</JapaneseText>
      <EnglishText>Th-Then you're an Eternal Hero, too!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269444</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_007&gt;</VoiceId>
      <JapaneseText>まぁ、そんなふうにも
呼ばれてるみたいだな</JapaneseText>
      <EnglishText>Well, I guess you could put it that way.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269572</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_008&gt;</VoiceId>
      <JapaneseText>ま、とりあえず入れよ</JapaneseText>
      <EnglishText>Anyways, let's go inside my place.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>8</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>269572</PointerOffset>
      <VoiceId>&lt;audio:VSM_110_060_009&gt;</VoiceId>
      <JapaneseText>って言っても、
オレんちじゃないけどな</JapaneseText>
      <EnglishText>...Or at least that's what I'd like to
say, but it's not really my house.</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>8</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
