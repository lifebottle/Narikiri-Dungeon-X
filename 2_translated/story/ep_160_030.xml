    <Entry>
      <PointerOffset>273316</PointerOffset>
      <VoiceId>&lt;audio:VSM_160_030_001&gt;</VoiceId>
      <JapaneseText>あれが『魔界の扉』か！？</JapaneseText>
      <EnglishText>That's...the Otherworldly Gate!?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273384</PointerOffset>
      <VoiceId>&lt;audio:VSM_160_030_002&gt;</VoiceId>
      <JapaneseText>おそらく……！</JapaneseText>
      <EnglishText>Seems like it...!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273476</PointerOffset>
      <VoiceId>&lt;audio:VSM_160_030_003&gt;</VoiceId>
      <JapaneseText>よし、ルナにもらった
光の力を使って……</JapaneseText>
      <EnglishText>Okay! Let's get close to it
and use Luna's light power!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273540</PointerOffset>
      <VoiceId>&lt;audio:VSM_160_030_004&gt;</VoiceId>
      <JapaneseText>魔物が……！</JapaneseText>
      <EnglishText>Monsters incoming!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273616</PointerOffset>
      <VoiceId>&lt;audio:VSM_160_030_005Z&gt;</VoiceId>
      <JapaneseText>扉を閉じさせるものか！</JapaneseText>
      <EnglishText>I won't let you close the gate!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
