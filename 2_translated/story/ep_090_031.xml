    <Section>Main</Section>
    <Entry>
      <PointerOffset>297740</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_008&gt;</VoiceId>
      <JapaneseText>勝ったぞ！！</JapaneseText>
      <EnglishText>We won!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297880</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_009&gt;</VoiceId>
      <JapaneseText>ゆ、許してたもれ……</JapaneseText>
      <EnglishText>I've...let my guard down.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297880</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_010&gt;</VoiceId>
      <JapaneseText>貴様らの願いを
なんでも叶えてしんぜようぞ</JapaneseText>
      <EnglishText>Insignificant insects. Voice
your trivial pleas, now!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>297980</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_011&gt;</VoiceId>
      <JapaneseText>んじゃあ、オレらに
精霊晶核っての分けてくれ！</JapaneseText>
      <EnglishText>We want you to give us your Atomism Core!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298100</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_012&gt;</VoiceId>
      <JapaneseText>精霊晶核とな？</JapaneseText>
      <EnglishText>My Atomism Core, you say?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <BubbleId>0</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298100</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_013&gt;</VoiceId>
      <JapaneseText>よかろう……
受け取るがよい</JapaneseText>
      <EnglishText>...Understood. You have asked
and you shall receive.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <BubbleId>1</BubbleId>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298172</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_014&gt;</VoiceId>
      <JapaneseText>さらばじゃ……</JapaneseText>
      <EnglishText>Farewell.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298252</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_015&gt;</VoiceId>
      <JapaneseText>四大精霊の力が集まった……！</JapaneseText>
      <EnglishText>We've collected all the Great Summon Spirits' powers...!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298316</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_016&gt;</VoiceId>
      <JapaneseText>クルール！</JapaneseText>
      <EnglishText>Kuruuuru! </EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298400</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_017&gt;</VoiceId>
      <JapaneseText>これで魔術の暴走が
抑えられるぜ</JapaneseText>
      <EnglishText>Now we can finally stop that magic
from doing any more harm!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298492</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_018&gt;</VoiceId>
      <JapaneseText>&lt;Klarth&gt;さん、本当に
ありがとうございます</JapaneseText>
      <EnglishText>Mister &lt;Klarth&gt;! Thank you so much!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298560</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_019&gt;</VoiceId>
      <JapaneseText>いや、なに……</JapaneseText>
      <EnglishText>It's nothing.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>12</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298628</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_020&gt;</VoiceId>
      <JapaneseText>&lt;Rody&gt;さんも</JapaneseText>
      <EnglishText>You too, Miss Rody!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>13</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298736</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_021&gt;</VoiceId>
      <JapaneseText>え……？　あ、うん、
これまたご丁寧に。
どういたしまして</JapaneseText>
      <EnglishText>Ah? Oh! That's very polite
of you. It was my pleasure
to be part of this journey!</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>14</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298812</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_022&gt;</VoiceId>
      <JapaneseText>君はこれからどうするんだ</JapaneseText>
      <EnglishText>What will you do from here on?</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>15</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298876</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_023&gt;</VoiceId>
      <JapaneseText>そうだね……</JapaneseText>
      <EnglishText>I wonder...</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>16</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>298968</PointerOffset>
      <VoiceId>&lt;audio:VSM_090_030_024&gt;</VoiceId>
      <JapaneseText>ま、とりあえず、
ここを出ましょうか！</JapaneseText>
      <EnglishText>Well, in any case, we need
to get out of here!</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>17</Id>
      <Status>Proofreading</Status>
    </Entry>
  </Strings>
