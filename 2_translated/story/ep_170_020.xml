    <Entry>
      <PointerOffset>272444</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_000&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272516</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_001&gt;</VoiceId>
      <JapaneseText>どうすんの、&lt;Mel&gt;</JapaneseText>
      <EnglishText>What will you do now, &lt;Mel&gt;?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272584</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_002&gt;</VoiceId>
      <JapaneseText>どうしようか……</JapaneseText>
      <EnglishText>That's a good question...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272668</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_003&gt;</VoiceId>
      <JapaneseText>……うーん……
どうしよう……</JapaneseText>
      <EnglishText>I really...don't know.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272792</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_004&gt;</VoiceId>
      <JapaneseText>……マクスウェルのとこに
精霊晶核が戻ってるかもって
ルナは言ってたけド</JapaneseText>
      <EnglishText>Luna said we should go visit Maxwell
to get the Atomism Cores back.
That's a good lead.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272888</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_005&gt;</VoiceId>
      <JapaneseText>エトと&lt;Couleur&gt;とで、
&lt;Red&gt;モーリア坑道&lt;White&gt;か……</JapaneseText>
      <EnglishText>I think you two should go to
&lt;Red&gt;Moria Mine&lt;White&gt; without me...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>272988</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_006&gt;</VoiceId>
      <JapaneseText>やっぱり&lt;Dio&gt;が
いた方がいいよね。
男の子だもの</JapaneseText>
      <EnglishText>I knew it. You'd rather
be at &lt;Dio&gt;'s side, right?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273088</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_007&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;なんかいなくても
……平気だよ……うん……</JapaneseText>
      <EnglishText>I'm sure we'll pull through...without...&lt;Dio&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273152</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_008&gt;</VoiceId>
      <JapaneseText>クルル！！</JapaneseText>
      <EnglishText>Kururu!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>273216</PointerOffset>
      <VoiceId>&lt;audio:VSM_170_020_009&gt;</VoiceId>
      <JapaneseText>何……！？</JapaneseText>
      <EnglishText>What..!?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <Status>Proofreading</Status>
    </Entry>
