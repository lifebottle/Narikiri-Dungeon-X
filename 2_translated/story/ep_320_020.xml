    <Entry>
      <PointerOffset>271424</PointerOffset>
      <VoiceId>&lt;audio:VSM_320_020_001&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
