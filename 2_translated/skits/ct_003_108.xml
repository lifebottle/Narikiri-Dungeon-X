    <Entry>
      <PointerOffset>41348,41424,41616,41768,41932</PointerOffset>
      <JapaneseText>&lt;Dio&gt;</JapaneseText>
      <EnglishText>&lt;Dio&gt;</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41520,41692,41868,42000</PointerOffset>
      <JapaneseText>&lt;Mel&gt;</JapaneseText>
      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>41352</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_001&gt;</VoiceId>
      <JapaneseText>……そう言や、ここ来たのって、
あいつらぶっ叩くためだっけ</JapaneseText>
      <EnglishText>...That reminds me. Wasn't the reason I came here
just 'cause I wanted to give those jerks a good punch?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41428</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_002&gt;</VoiceId>
      <JapaneseText>オレ、すっかり忘れてた</JapaneseText>
      <EnglishText>I kinda completely
forgot about that.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41524</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_003&gt;</VoiceId>
      <JapaneseText>するべきことが
すっきりと見えたからかな？</JapaneseText>
      <EnglishText>Because you could finally really see
what it was you needed to do, I guess?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41620</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_004&gt;</VoiceId>
      <JapaneseText>んだな、それにあいつらにも
もう怒ってないし</JapaneseText>
      <EnglishText>Yeah, and 'cause I'm not really
angry at them anymore.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41696</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_005&gt;</VoiceId>
      <JapaneseText>自分に怒っても仕方ないよ</JapaneseText>
      <EnglishText>There's no point in
being mad at yourself.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41772</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_006&gt;</VoiceId>
      <JapaneseText>あいつらはオレらだもんな</JapaneseText>
      <EnglishText>Yeah. And
they're us.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41872</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_007&gt;</VoiceId>
      <JapaneseText>ふふ、なんか、&lt;Dio&gt;、
すっきりした顔してるね</JapaneseText>
      <EnglishText>Haha. You look really
refreshed, somehow, &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>41936</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_008&gt;</VoiceId>
      <JapaneseText>おまえもな</JapaneseText>
      <EnglishText>So do you.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42004</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_108_009&gt;</VoiceId>
      <JapaneseText>よし……行こ！</JapaneseText>
      <EnglishText>Alright... Let's go!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
  <Strings>
