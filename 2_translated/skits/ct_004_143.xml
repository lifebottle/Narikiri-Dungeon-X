  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>45504</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_001&gt;</VoiceId>
      <JapaneseText>精霊って召喚されるたびに疲れねのかな。
なんか食わせてやろうぜ</JapaneseText>
      <EnglishText>Y'know, summoning these spirits, having them
fight for us... They must be hungry by now, right?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45588</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_002&gt;</VoiceId>
      <JapaneseText>精霊がものを食べるわけないだろう</JapaneseText>
      <EnglishText>Well, no. They're spirits.
Of course they don't eat...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45664</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_003&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;じゃあるまいシ……</JapaneseText>
      <EnglishText>They're not like you, &lt;Dio&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45736</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_004&gt;</VoiceId>
      <JapaneseText>マジでそうなのか？</JapaneseText>
      <EnglishText>Oh, huh... ...Really?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45848</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_005&gt;</VoiceId>
      <JapaneseText>……ほれ、ほれほれ、肉だぞ。
ノーム、イフリート見えっか？</JapaneseText>
      <EnglishText>Yo, spirits. I've got some meat for you
guys. Gnome? Efreet? You see this?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45952</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_006&gt;</VoiceId>
      <JapaneseText>おい、やめるんだ。
こんなところで肉を出すなんて……</JapaneseText>
      <EnglishText>Whoa, whoa, stop that! Don't wave raw
meat around like that, you might attract...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46140</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_009&gt;</VoiceId>
      <JapaneseText>グルルル。グルルル</JapaneseText>
      <EnglishText>Grrr.... Grrrr!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46228</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_010&gt;</VoiceId>
      <JapaneseText>ファァァァ……
野犬に食べられちゃう</JapaneseText>
      <EnglishText>Oh no... These
wolves look hungry...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46296</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_011&gt;</VoiceId>
      <JapaneseText>うわっ！！アブね</JapaneseText>
      <EnglishText>Whoa! Too close.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46372</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_012&gt;</VoiceId>
      <JapaneseText>危ない！！いでよノーム</JapaneseText>
      <EnglishText>Get out of the way! I
summon you, Gnome!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46464</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_013&gt;</VoiceId>
      <JapaneseText>倒してやったぞ～。
ありがたく思うのら～</JapaneseText>
      <EnglishText>I just saved your bacon, dudes!
Hope you're, like...thankful.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46568</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_014&gt;</VoiceId>
      <JapaneseText>ふざけすぎなのら。
ボクたちは肉なんて食べないのら～</JapaneseText>
      <EnglishText>But, hey, don't write any more checks your tush can't cash,
yeah? We Gnomes don't eat that meat junk, anyway!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>12</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46668</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_015&gt;</VoiceId>
      <JapaneseText>あんまりナメると
『野良』を呼んじゃう『のら』～</JapaneseText>
      <EnglishText>Make a "Gnome" too upset and you'll get ditched,
dude. Like, left behind in..."Gnome" Man's Land!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>13</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46728</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_016&gt;</VoiceId>
      <JapaneseText>…………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>14</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46796</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_017&gt;</VoiceId>
      <JapaneseText>さむっ…………</JapaneseText>
      <EnglishText>...Uhh...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>15</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46872</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_143_018&gt;</VoiceId>
      <JapaneseText>……&lt;Cless&gt;さん２号……？</JapaneseText>
      <EnglishText>...Not another &lt;Cless&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>16</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
