      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43504,43644,43776,43964</PointerOffset>
      <JapaneseText>&lt;Dio&gt;</JapaneseText>
      <EnglishText>&lt;Dio&gt;</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43572,43708,43892,44140</PointerOffset>
      <JapaneseText>エトス</JapaneseText>
      <EnglishText>Ethos</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>43440</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_001&gt;</VoiceId>
      <JapaneseText>街もないし、人もいない……
なんか気味が悪いね、暗黒時空って……</JapaneseText>
      <EnglishText>No towns, no people... This "Dimensional
Darkness" is kind of creepy...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43508</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_002&gt;</VoiceId>
      <JapaneseText>真っ暗だしな……</JapaneseText>
      <EnglishText>And being pitch
dark doesn't help...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43576</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_003&gt;</VoiceId>
      <JapaneseText>暗いの、怖いの？</JapaneseText>
      <EnglishText>Are you afraid
of the dark?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43648</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_004&gt;</VoiceId>
      <JapaneseText>怖くなんてねーよ？</JapaneseText>
      <EnglishText>Hey, nah, I'm not
scared at all.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43712</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_005&gt;</VoiceId>
      <JapaneseText>うふふ……</JapaneseText>
      <EnglishText>Ehehe...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43780</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_006&gt;</VoiceId>
      <JapaneseText>な、なんだよ……</JapaneseText>
      <EnglishText>Wh-What...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43896</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_007&gt;</VoiceId>
      <JapaneseText>夜中に一人じゃトイレに行けない
って言ってたのを思い出しちゃった</JapaneseText>
      <EnglishText>I just remembered that time you said you
couldn't go to the toilet alone at night.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43968</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_008&gt;</VoiceId>
      <JapaneseText>メ、&lt;Mel&gt;だろ、それ</JapaneseText>
      <EnglishText>Th-That was &lt;Mel&gt;, wasn't it?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44040</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_009&gt;</VoiceId>
      <JapaneseText>わたしじゃないよ？</JapaneseText>
      <EnglishText>It wasn't me.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44144</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_010&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;は暗くなると興奮して
寝つけなかった方だもんね</JapaneseText>
      <EnglishText>'Cause &lt;Mel&gt; was the one who always got
excited at night and wouldn't go to sleep.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44228</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_086_011&gt;</VoiceId>
      <JapaneseText>え？　え？
そ、そうだったかな？</JapaneseText>
      <EnglishText>Eh? Eh?
Did I...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>Notice</Section>
