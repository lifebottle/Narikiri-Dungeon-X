    </Entry>
    <Entry>
      <PointerOffset>47736,47908,48064</PointerOffset>
      <JapaneseText>&lt;Dio&gt;</JapaneseText>
      <EnglishText>&lt;Dio&gt;</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47980,48140,48360,48572</PointerOffset>
      <JapaneseText>&lt;Mel&gt;</JapaneseText>
      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>47668</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_002&gt;</VoiceId>
      <JapaneseText>やっぱり、朝は一杯の牛乳さんがいないと
始まんないと思うんだよね</JapaneseText>
      <EnglishText>I just can't start my day
without my morning cup of milk.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47740</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_003&gt;</VoiceId>
      <JapaneseText>……オヤジくせー……</JapaneseText>
      <EnglishText>...You're like
an old man...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47828</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_004&gt;</VoiceId>
      <JapaneseText>そう？　どこが？
ここ？　ここかな？</JapaneseText>
      <EnglishText>Am I? How so? Oh,
you mean these here?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47912</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_005&gt;</VoiceId>
      <JapaneseText>ちょっ……
ちか、近い近い……</JapaneseText>
      <EnglishText>Wa-... Th-That's
too close...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47984</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_006&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;、顔が赤いよ</JapaneseText>
      <EnglishText>&lt;Dio&gt;, you're
blushing.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48068</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_007&gt;</VoiceId>
      <JapaneseText>こ、これは……暑いんだっつーの！</JapaneseText>
      <EnglishText>Th-That's just
'cause I'm too hot...!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48144</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_008&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;で楽しむの禁止です</JapaneseText>
      <EnglishText>Hands off &lt;Dio&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48244</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_009&gt;</VoiceId>
      <JapaneseText>そう？　んじゃあ、
&lt;Mel&gt;ちゃんで楽しんじゃお</JapaneseText>
      <EnglishText>Oh? Then maybe I'll touch
you a little, instead~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48364</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_010&gt;</VoiceId>
      <JapaneseText>あ、ちょっと……何するんですか、
&lt;Rody&gt;さん、あっ、そんなとこ……</JapaneseText>
      <EnglishText>Ah, wait... What are you
doing, &lt;Rody&gt;? Ah, not there...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48488</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_011&gt;</VoiceId>
      <JapaneseText>ん～、&lt;Mel&gt;ちゃんも毎朝、牛乳さん飲んだ方が
ペッタンコ治るよ、たぶん</JapaneseText>
      <EnglishText>Hmm~ If you'd drink milk in the morning, too,
&lt;Mel&gt;ly, it might help with your "pancake" problem~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48576</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_063_012&gt;</VoiceId>
      <JapaneseText>……ま、まだ成長期なんです～っ！！</JapaneseText>
      <EnglishText>...H-Hey, I'm still growing...!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>Notice</Section>
  </Strings>
</SceneText>
