      <JapaneseText>エトス</JapaneseText>
      <EnglishText>Ethos</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48780,49076,49316,49488</PointerOffset>
      <JapaneseText>アルベルト</JapaneseText>
      <EnglishText>Albert</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48960,49164</PointerOffset>
      <JapaneseText>&lt;Dio&gt;</JapaneseText>
      <EnglishText>&lt;Dio&gt;</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>49572</PointerOffset>
      <JapaneseText>&lt;Mel&gt;</JapaneseText>
      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>48604</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_001&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;、ちゃんと必要なもの
買ったね</JapaneseText>
      <EnglishText>You bought everything we
need, didn't you, &lt;Mel&gt;?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48692</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_002&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;、ほら、
ボタン掛け違えてる</JapaneseText>
      <EnglishText>Oh, &lt;Dio&gt;. Look, you put one of
your buttons in the wrong hole.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48784</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_003&gt;</VoiceId>
      <JapaneseText>エト助は、ふたりの保護者みたいだなや</JapaneseText>
      <EnglishText>Ya really are like their
guardian, aren't ya, Ethos?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48880</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_004&gt;</VoiceId>
      <JapaneseText>そうだよ！
ぼくはふたりのお母さんだもん！</JapaneseText>
      <EnglishText>Yes, I am! Because
I'm their mom!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48964</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_005&gt;</VoiceId>
      <JapaneseText>へん、エトが
母ちゃんなもんかよ</JapaneseText>
      <EnglishText>Hmph. How could
Ethos be *my* mom?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>49080</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_006&gt;</VoiceId>
      <JapaneseText>あはは～～ん。
おめぇ、ほんとはエト助のこと、大好きなんだべ</JapaneseText>
      <EnglishText>Ahahahaaa~ Truth is, ya really
*do* love Ethos, don't ya, brat?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>49168</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_007&gt;</VoiceId>
      <JapaneseText>うるせー！　タンス野郎は黙ってろ！！</JapaneseText>
      <EnglishText>Shaddup! Closet freaks
shouldn't talk!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>49320</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_008&gt;</VoiceId>
      <JapaneseText>はぁん？　誰に向かってタンス言ってんだど！
おめぇなんぞ、毛も生えてねぇ、ハゲぼうずのくせが！</JapaneseText>
      <EnglishText>Huuuh? Who d'ya think you're callin' a closet!? Ya
wouldn't know furniture if it fell on yer head, ya numbskull!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>49408</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_009&gt;</VoiceId>
      <JapaneseText>ほら、ふたりともけんかしちゃだめ！</JapaneseText>
      <EnglishText>Hey, you two,
no fighting!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>49492</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_010&gt;</VoiceId>
      <JapaneseText>す……すまねーだ、母ちゃん</JapaneseText>
      <EnglishText>S...Sorry, Mama...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>49576</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_003_011&gt;</VoiceId>
      <JapaneseText>あれ……アルベルトさんまで……</JapaneseText>
      <EnglishText>Wait... Now Albert, too...?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>Notice</Section>
  </Strings>
</SceneText>
