<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>44496,44636,44908,45168</PointerOffset>
      <JapaneseText>&lt;Dio&gt;</JapaneseText>
      <EnglishText>&lt;Dio&gt;</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>44564,44788,45048,45240</PointerOffset>
      <JapaneseText>アルベルト</JapaneseText>
      <EnglishText>Albert</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>44500</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_157_001&gt;</VoiceId>
      <JapaneseText>あーあ、つまんね！　オレも戦わせろっ！</JapaneseText>
      <EnglishText>Man, I'm frickin' bored!
Let me fight, too!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44568</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_157_002&gt;</VoiceId>
      <JapaneseText>ぷぷぷ、ぷぷ</JapaneseText>
      <EnglishText>Aha, ahahahaa!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44640</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_157_003&gt;</VoiceId>
      <JapaneseText>なに笑ってんだよ……</JapaneseText>
      <EnglishText>What're you laughing at?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44792</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_157_004&gt;</VoiceId>
      <JapaneseText>いやぁいやいや、笑うなんて、滅相もねーだーよ。
戦闘から外されて、傷心の&lt;Dio&gt;さんを笑うだなんて</JapaneseText>
      <EnglishText>Oh no, no, no. Me, laughin'? 'Course not. &lt;Dio&gt;, gettin' kicked out of the party? Nope, that ain't hilarious at all!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44912</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_157_005&gt;</VoiceId>
      <JapaneseText>へん！　そうやって、バカにしてろよ。
どーせ、すぐ戻ってやっからさ</JapaneseText>
      <EnglishText>Hmph! Well, make fun of me all you
like. They'll call me back in soon.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45052</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_157_006&gt;</VoiceId>
      <JapaneseText>甘い、甘い！　甘いんなー！！　そうやって
立場にあぐらかいてっから、外されるんだ！！</JapaneseText>
      <EnglishText>Ya think so? Really? Face it: ye've been takin' yer
position for granted, and now ye've gone and lost it!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45172</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_157_007&gt;</VoiceId>
      <JapaneseText>た、たしかに、オレ、主人公のはずなのに、
戦闘から外されるなんて……</JapaneseText>
      <EnglishText>Th-That's... I mean... Well, it's true that I'm pretty much
the main character, and I'm not even in the party...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45244</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_157_008&gt;</VoiceId>
      <JapaneseText>ざまぁねぇだ、な</JapaneseText>
      <EnglishText>Ha! Serves ya right!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
</SceneText>
