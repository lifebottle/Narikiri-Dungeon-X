      <EnglishText>Ethos</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45480</PointerOffset>
      <JapaneseText>&lt;Couleur&gt;</JapaneseText>
