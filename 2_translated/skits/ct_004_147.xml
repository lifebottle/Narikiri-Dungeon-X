  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>43848</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_000&gt;</VoiceId>
      <JapaneseText>ありがとう、&lt;Mint&gt;。
君のおかげでいつも助かってるよ</JapaneseText>
      <EnglishText>Thanks、&lt;Mint&gt;. You're always
there when I need you.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43932</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_001&gt;</VoiceId>
      <JapaneseText>そんな…いいんですよ、&lt;Cless&gt;さん</JapaneseText>
      <EnglishText>That's, um... I mean, I didn't
do that much, &lt;Cless&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44012</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_002&gt;</VoiceId>
      <JapaneseText>……あのっ、あ……</JapaneseText>
      <EnglishText>...You know...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44156</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_004&gt;</VoiceId>
      <JapaneseText>&lt;Cless&gt;さんからどうぞ</JapaneseText>
      <EnglishText>Um... You can go first, &lt;Cless&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44224</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_005&gt;</VoiceId>
      <JapaneseText>いや、君から…</JapaneseText>
      <EnglishText>No, it's fine, you should...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44296</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_006&gt;</VoiceId>
      <JapaneseText>………………</JapaneseText>
      <EnglishText>...</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44464</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_008&gt;</VoiceId>
      <JapaneseText>ああ！　もう見てらんない！
何、この甘酸っぱいの！</JapaneseText>
      <EnglishText>Ahh, I can't take it anymore! Just...
go and get a room, you two!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44536</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_009&gt;</VoiceId>
      <JapaneseText>ひがむな、ひがむな</JapaneseText>
      <EnglishText>Now, don't get jealous, &lt;Arche&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44640</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_010&gt;</VoiceId>
      <JapaneseText>ち、違うってば！
年寄りのひがみとかじゃないからね！</JapaneseText>
      <EnglishText>Th-That's not it at all! But, a lonely
old man would think like that!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44732</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_147_011&gt;</VoiceId>
      <JapaneseText>いや、オレ、そんなこと言ってないし……</JapaneseText>
      <EnglishText>Wait, but I'm not the one who...</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
