  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>46856,47036,47260,48072</PointerOffset>
      <JapaneseText>&lt;Suzu&gt;</JapaneseText>
      <EnglishText>&lt;Suzu&gt;</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46968,47168,47364,47620,47772,47908</PointerOffset>
      <JapaneseText>アルベルト</JapaneseText>
      <EnglishText>Albert</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47480,48008</PointerOffset>
      <JapaneseText>&lt;Mel&gt;</JapaneseText>
      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>46860</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_001&gt;</VoiceId>
      <JapaneseText>こ、これは？</JapaneseText>
      <EnglishText>Th-This is...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46972</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_002&gt;</VoiceId>
      <JapaneseText>やーやーやー、どもども。
『&lt;Suzu&gt;ちん』はじめましてだど</JapaneseText>
      <EnglishText>Hey, hey, hey, good
to meet ya, li'l &lt;Suzu&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47040</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_003&gt;</VoiceId>
      <JapaneseText>は、はじめまして</JapaneseText>
      <EnglishText>N-Nice to meet you.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47172</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_004&gt;</VoiceId>
      <JapaneseText>いんやー、&lt;Suzu&gt;ちんは&lt;Mel&gt;&lt;Mel&gt;に劣らず
かわいいだな。すんばらしいだーよ</JapaneseText>
      <EnglishText>My, my~ Li'l &lt;Suzu&gt;'s every bit as cute
as &lt;Mel&gt;&lt;Mel&gt; is. Real wonderful stuff.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47264</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_005&gt;</VoiceId>
      <JapaneseText>……そんなこと突然、言われても困ります</JapaneseText>
      <EnglishText>...Saying such things
will only trouble me.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47368</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_006&gt;</VoiceId>
      <JapaneseText>えーだ、えーだ。その照れてる顔もグッとくるだどー</JapaneseText>
      <EnglishText>Don't worry yer pretty little head about it.
Yer embarrassed face hits just right, too~</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47484</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_007&gt;</VoiceId>
      <JapaneseText>アルベルトさん、
新しい女の人が来るたび同じこと言ってませんか？</JapaneseText>
      <EnglishText>But Albert, don't you say the same things
every time a woman joins the group?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47624</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_008&gt;</VoiceId>
      <JapaneseText>おんやー、&lt;Mel&gt;&lt;Mel&gt;、嫉妬だべかぁ～？
嫉妬かぁ？　いんや、モテる男は辛いだーな</JapaneseText>
      <EnglishText>Oh my, you aren't gettin' jealous, now, are ya,
&lt;Mel&gt;&lt;Mel&gt;~? Ahh, bein' a popular man's so hard...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47776</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_009&gt;</VoiceId>
      <JapaneseText>んなもん、&lt;Mel&gt;&lt;Mel&gt;が一番に決まってるだーよ。
だども、&lt;Suzu&gt;ちんのあの恥じらい、捨てがてなぁ</JapaneseText>
      <EnglishText>But don't worry. You're my number one, &lt;Mel&gt;&lt;Mel&gt;.
But li'l Suzu's bashfulness is so hard to give up~...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>47912</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_010&gt;</VoiceId>
      <JapaneseText>どうすっかなぁ。あっちもいいけどこっちもええな。
贅沢な悩みだーな。ぶつぶつ……</JapaneseText>
      <EnglishText>What'll I do...? Ya just can't go wrong with
either, can ya? So hard to choose... *mumble*</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48012</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_011&gt;</VoiceId>
      <JapaneseText>あまり、気にしないでね。いつも、あんな感じだから</JapaneseText>
      <EnglishText>Don't pay him any mind.
He's always like that.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>48076</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_064_012&gt;</VoiceId>
      <JapaneseText>は、はい……</JapaneseText>
      <EnglishText>Y-Yes...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>12</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
