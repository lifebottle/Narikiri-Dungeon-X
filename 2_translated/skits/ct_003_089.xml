      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42320,42484,42644,42748,42836,43036,43180</PointerOffset>
      <JapaneseText>&lt;Rondoline&gt;</JapaneseText>
      <EnglishText>&lt;Rondoline&gt;</EnglishText>
      <Notes/>
