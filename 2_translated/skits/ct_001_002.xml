<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>42896,42992,43212,43340,43616</PointerOffset>
      <JapaneseText>エトス</JapaneseText>
      <EnglishText>Ethos</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43088,43272,43500</PointerOffset>
      <JapaneseText>&lt;Mel&gt;</JapaneseText>
      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43432</PointerOffset>
      <JapaneseText>&lt;Dio&gt;</JapaneseText>
      <EnglishText>&lt;Dio&gt;</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>42900</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_001&gt;</VoiceId>
      <JapaneseText>ヴァルハラか。なつかしいな～</JapaneseText>
      <EnglishText>Valhalla, huh. This
really takes me back~</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42996</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_002&gt;</VoiceId>
      <JapaneseText>前来たのは……
仲間探してた時だったっけ…</JapaneseText>
      <EnglishText>The last time I came here...must have
been when I was looking for other fairies.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43092</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_003&gt;</VoiceId>
      <JapaneseText>……エトはまたいつか、
旅立っちゃうの……？</JapaneseText>
      <EnglishText>...Will you leave to go on another
journey someday, Ethos...?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43216</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_004&gt;</VoiceId>
      <JapaneseText>仲間を探して？　うふふ、きみたちを
ほってどこかに行けるはずないでしょ？</JapaneseText>
      <EnglishText>To look for fairy friends? Ahaha, of course
I won't just leave you two like that.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43276</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_005&gt;</VoiceId>
      <JapaneseText>本当に？</JapaneseText>
      <EnglishText>Really?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43344</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_006&gt;</VoiceId>
      <JapaneseText>ずっと一緒だよ？</JapaneseText>
      <EnglishText>I've always been here
for you, haven't I?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43436</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_007&gt;</VoiceId>
      <JapaneseText>マジで、&lt;Mel&gt;って
エトには甘えん坊だな</JapaneseText>
      <EnglishText>You're so
spoiled, &lt;Mel&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43504</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_008&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;もでしょ</JapaneseText>
      <EnglishText>Aren't you, too, &lt;Dio&gt;?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43620</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_002_009&gt;</VoiceId>
      <JapaneseText>……だってね……きみたちがいれば
他に仲間なんて必要ないかラ……</JapaneseText>
      <EnglishText>...Because...as long as I have you
two, I have everything I need...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>Notice</Section>
  </Strings>
</SceneText>
