<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>43388,43600,43804,43912</PointerOffset>
      <JapaneseText>&lt;Mel&gt;</JapaneseText>
      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>43500,43704,44048</PointerOffset>
      <JapaneseText>アルベルト</JapaneseText>
      <EnglishText>Albert</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>43392</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_170_001&gt;</VoiceId>
      <JapaneseText>よし！　次はこっちのコスチュームを着て……</JapaneseText>
      <EnglishText>Alright! Next time, I'll change into this...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43504</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_170_002&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;&lt;Mel&gt;、頑張ってるだなぁ。いっぱい着替えまくっで</JapaneseText>
      <EnglishText>Ya really change a lot, don't ya, &lt;Mel&gt;&lt;Mel&gt;?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43604</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_170_003&gt;</VoiceId>
      <JapaneseText>わたしの力が役立つなら、
精いっぱいやらないと！</JapaneseText>
      <EnglishText>I know my powers are helpful,
so I'll use them as much as I can!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43708</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_170_004&gt;</VoiceId>
      <JapaneseText>すんばらしーだ。おら感動で、目から汗が出てきたど</JapaneseText>
      <EnglishText>Yer dedication is breath-takin'. So
overwhelmin', even, I just might cry...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43808</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_170_005&gt;</VoiceId>
      <JapaneseText>アルベルトさんだって、頑張って、くれてるじゃない</JapaneseText>
      <EnglishText>Well, you've been helping
us a lot, too, &lt;Albert&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43916</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_170_006&gt;</VoiceId>
      <JapaneseText>……と、よし！　着替え終わった。
じゃ、行ってきまーす！</JapaneseText>
      <EnglishText>...and, there, my new clothes
are on! Okay, time to go!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44052</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_170_007&gt;</VoiceId>
      <JapaneseText>&lt;Mel&gt;&lt;Mel&gt;の着替えを毎回手伝えるなら、
おらは何百着だって持つだーよ。うふ∀</JapaneseText>
      <EnglishText>If I can help &lt;Mel&gt;&lt;Mel&gt; gettin' changed, I'll let
her stuff all the clothes she wants into me... Hehe...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
</SceneText>
