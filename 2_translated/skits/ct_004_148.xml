    <Entry>
      <PointerOffset>46016</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_001&gt;</VoiceId>
      <JapaneseText>やった！　優勝だぜ！
ふふふふふ！　あいあむあちゃんぴょーん！</JapaneseText>
      <EnglishText>Hell yeah, I won! Ahahaha!
I...am...the champiooon!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46084</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_002&gt;</VoiceId>
      <JapaneseText>&lt;Dio&gt;、おめでと</JapaneseText>
      <EnglishText>Congrats, &lt;Dio&gt;!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46164</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_003&gt;</VoiceId>
      <JapaneseText>ぼくも母親として鼻が高いよ！</JapaneseText>
      <EnglishText>As a mom, I couldn't be more proud!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46236</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_004&gt;</VoiceId>
      <JapaneseText>クルール！　クルール</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>46340</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_005&gt;</VoiceId>
      <JapaneseText>ふふふ。サンキュー皆の衆。よきにはから……えっ！？</JapaneseText>
      <EnglishText>Mhm, mhm. Thank you, thank you very muuuouch!
</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46404</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_006&gt;</VoiceId>
      <JapaneseText>クルール！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>46488</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_007&gt;</VoiceId>
      <JapaneseText>なかなか起き上がんないけど……</JapaneseText>
      <EnglishText>Um... Why can't you get up...?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46564</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_008&gt;</VoiceId>
      <JapaneseText>ちょっと&lt;Dio&gt;、平気？</JapaneseText>
      <EnglishText>&lt;Dio&gt;, are you okay?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46632</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_009&gt;</VoiceId>
      <JapaneseText>い……てぇ～……</JapaneseText>
      <EnglishText>So much...pain...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46696</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_010&gt;</VoiceId>
      <JapaneseText>クルクル？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>46812</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_011&gt;</VoiceId>
      <JapaneseText>……そこの……角に……
小指……思いっっっっきり……ぶつけた……</JapaneseText>
      <EnglishText>That corner...there... I bumped...
my finger...into it...really hard...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46944</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_148_012&gt;</VoiceId>
      <JapaneseText>天狗になってるから、そういう目に合うだ。
ざまぁねぇだ、ぼんくらちゃんぽんが</JapaneseText>
      <EnglishText>You got such a cocky attitude, o' course somethin's
gonna knock ya back down! Serves ya right, "champ"!</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>12</Id>
      <Status>Editing</Status>
    </Entry>
