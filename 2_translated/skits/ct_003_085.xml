  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>42140</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_001&gt;</VoiceId>
      <JapaneseText>もし、家にいたら、
今頃、お風呂入ってる時間だな……</JapaneseText>
      <EnglishText>If we were at home, I guess this
would be about the time for a bath...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42216</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_002&gt;</VoiceId>
      <JapaneseText>オレは、本読んでるかも</JapaneseText>
      <EnglishText>And I'd probably be
reading a book about now.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42316</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_003&gt;</VoiceId>
      <JapaneseText>せっかく読みたかったのに、
あいつらのせいで……</JapaneseText>
      <EnglishText>I really wanted to read that one,
too... But all 'cause of those jerks, I...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42396</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_004&gt;</VoiceId>
      <JapaneseText>大丈夫だよ、&lt;Dio&gt;、&lt;Mel&gt;</JapaneseText>
      <EnglishText>It's okay, &lt;Dio&gt;, &lt;Mel&gt;.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42496</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_005&gt;</VoiceId>
      <JapaneseText>明日の今頃はきっと家で、
ゆっくりしてるはずだよ</JapaneseText>
      <EnglishText>At this time tomorrow, I'm
sure we'll be relaxing at home.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42564</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_006&gt;</VoiceId>
      <JapaneseText>そう、かな……？</JapaneseText>
      <EnglishText>You think so...?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42632</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_007&gt;</VoiceId>
      <JapaneseText>クルークルル～？</JapaneseText>
      <EnglishText>Couleu Couluru~?</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42720</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_008&gt;</VoiceId>
      <JapaneseText>うん。そんなふうに想像してごらんよ</JapaneseText>
      <EnglishText>Yeah. Just try
and imagine it.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42808</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_009&gt;</VoiceId>
      <JapaneseText>なんかあっという間だって思わない？</JapaneseText>
      <EnglishText>It feels like it'll happen
really soon, doesn't it?</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42880</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_010&gt;</VoiceId>
      <JapaneseText>……うん……だな！</JapaneseText>
      <EnglishText>...Yeah... It kinda does!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42936</PointerOffset>
      <VoiceId>&lt;audio:VCT_003_085_011&gt;</VoiceId>
      <JapaneseText>行こ</JapaneseText>
      <EnglishText>Let's go.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
