<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>42740,42976,43216,43440,43708</PointerOffset>
      <JapaneseText>&lt;Mel&gt;</JapaneseText>
      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42820,43088,43336,43512,43648,43812</PointerOffset>
      <JapaneseText>エトス</JapaneseText>
      <EnglishText>Ethos</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42888</PointerOffset>
      <JapaneseText>&lt;Couleur&gt;</JapaneseText>
      <EnglishText>&lt;Couleur&gt;</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>42744</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_001&gt;</VoiceId>
      <JapaneseText>わたし……あの人のこと、
許せないよ</JapaneseText>
      <EnglishText>I...won't forgive
him for this.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42824</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_002&gt;</VoiceId>
      <JapaneseText>あの人って……バジルさん？</JapaneseText>
      <EnglishText>Him... You mean Basil?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42892</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_003&gt;</VoiceId>
      <JapaneseText>クルール……！</JapaneseText>
      <EnglishText>Couleuru...!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>42980</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_004&gt;</VoiceId>
      <JapaneseText>……最後の最後に&lt;Dio&gt;を傷つけて……</JapaneseText>
      <EnglishText>...He spent his very last
moments on hurting &lt;Dio&gt;...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43092</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_005&gt;</VoiceId>
      <JapaneseText>かもしれない。でも、バジルさんは、
もう死んじゃったんだよ？</JapaneseText>
      <EnglishText>Maybe he did. But Basil's
already dead, isn't he?</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43220</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_006&gt;</VoiceId>
      <JapaneseText>だからよけいに許せないの。怒れる相手が
もういなくて、怒る意味ないから……</JapaneseText>
      <EnglishText>That's even more reason I can't forgive him. He
died, so he even made my anger meaningless.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43340</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_007&gt;</VoiceId>
      <JapaneseText>だったらわかってるでしょ。
許せないって言ってもどうしようもないこと</JapaneseText>
      <EnglishText>But you understand, right? Even if you hold
it against him, it won't do you any good.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43444</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_008&gt;</VoiceId>
      <JapaneseText>そう……だよね……
でも、気持ちがおさまらなくて……</JapaneseText>
      <EnglishText>You're right...but... It doesn't
make me feel any better...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43516</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_009&gt;</VoiceId>
      <JapaneseText>それはわかるけド……</JapaneseText>
      <EnglishText>I understand
that, but...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43652</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_010&gt;</VoiceId>
      <JapaneseText>今は傷ついた&lt;Dio&gt;をなんとかすることでしか、
それをおさめることはできないと思うんだ</JapaneseText>
      <EnglishText>I think the only thing you can do about
that now is try to help &lt;Dio&gt; feel better.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43712</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_011&gt;</VoiceId>
      <JapaneseText>うん……</JapaneseText>
      <EnglishText>Yeah...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>43816</PointerOffset>
      <VoiceId>&lt;audio:VCT_002_058_012&gt;</VoiceId>
      <JapaneseText>ぼくだって……
許せない気持ち、&lt;Mel&gt;と同じだよ……</JapaneseText>
      <EnglishText>But, I feel the same way, &lt;Mel&gt;...
I can't forgive him, either...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>Notice</Section>
  </Strings>
</SceneText>
