<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>44856,45036,45200,45656</PointerOffset>
      <JapaneseText>&lt;Mel&gt;</JapaneseText>
      <EnglishText>&lt;Mel&gt;</EnglishText>
      <Notes/>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44936,45104,45464,45580</PointerOffset>
      <JapaneseText>&lt;Dio&gt;</JapaneseText>
      <EnglishText>&lt;Dio&gt;</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45276,45396</PointerOffset>
      <JapaneseText>エトス</JapaneseText>
      <EnglishText>Ethos</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>44860</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_001&gt;</VoiceId>
      <JapaneseText>ちょっと&lt;Dio&gt;、
バタバタしないの</JapaneseText>
      <EnglishText>Hey, &lt;Dio&gt;,
no running.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>44940</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_002&gt;</VoiceId>
      <JapaneseText>妹が、兄貴に命令すんなよ！</JapaneseText>
      <EnglishText>Little sisters shouldn't order
their older brothers around!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45040</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_003&gt;</VoiceId>
      <JapaneseText>何言ってんの？
私がお姉ちゃん、&lt;Dio&gt;は弟でしょ</JapaneseText>
      <EnglishText>What are you talking about? I'm the
older sister. You're my younger brother.</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45108</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_004&gt;</VoiceId>
      <JapaneseText>オレの方が上だ！</JapaneseText>
      <EnglishText>No, I'm older!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45204</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_005&gt;</VoiceId>
      <JapaneseText>もう……エトぉ！
お姉ちゃんはわたしだよね？</JapaneseText>
      <EnglishText>Jeez... Hey, Ethos! I'm
his older sister, right?</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>5</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45280</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_006&gt;</VoiceId>
      <JapaneseText>だから、わかんないってば</JapaneseText>
      <EnglishText>I keep telling
you, I don't know!</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45400</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_007&gt;</VoiceId>
      <JapaneseText>ふたり一緒にぼくんとこに来たんだって。
前から何度も言ってるでしょ</JapaneseText>
      <EnglishText>I must have told you a thousand times. "You
both came to live with me at the same time."</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45468</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_008&gt;</VoiceId>
      <JapaneseText>んだよ、もう……</JapaneseText>
      <EnglishText>Ugh, come on...</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45584</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_009&gt;</VoiceId>
      <JapaneseText>よーし！　今日こそ虫とり対決で、
白黒はっきりつけるぞ、&lt;Mel&gt;！</JapaneseText>
      <EnglishText>Aaalriiight! Today, we're gonna have a
bug-catching contest, and if I win, I'm older!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45660</PointerOffset>
      <VoiceId>&lt;audio:VCT_001_001_010&gt;</VoiceId>
      <JapaneseText>もうっ！　お子ちゃまっ！</JapaneseText>
      <EnglishText>Jeez! You're such a child!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>Notice</Section>
  </Strings>
</SceneText>
