    <Entry>
      <PointerOffset>45672</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_001&gt;</VoiceId>
      <JapaneseText>はっ</JapaneseText>
      <EnglishText>Hah!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>1</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45732</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_002&gt;</VoiceId>
      <JapaneseText>やあっ！</JapaneseText>
      <EnglishText>Hiyah!</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45800</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_003&gt;</VoiceId>
      <JapaneseText>もっと左か……</JapaneseText>
      <EnglishText>...A bit further to the left...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45884</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_004&gt;</VoiceId>
      <JapaneseText>&lt;Chester&gt;さん一生懸命練習してるね</JapaneseText>
      <EnglishText>&lt;Chester&gt; really puts his all into practice, huh.</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>4</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>45952</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_005&gt;</VoiceId>
      <JapaneseText>クルルール！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>46044</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_006&gt;</VoiceId>
      <JapaneseText>時空戦士なのに、いまだに特訓してんだな</JapaneseText>
      <EnglishText>So even the Heroes of Time still practice...</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46136</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_007&gt;</VoiceId>
      <JapaneseText>……&lt;Chester&gt;は自分が弱いって思ってるんだ</JapaneseText>
      <EnglishText>&lt;Chester&gt; still thinks of himself as weak.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46224</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_008&gt;</VoiceId>
      <JapaneseText>もちろん、そんなことはないんだけどね</JapaneseText>
      <EnglishText>Of course, he's actually quite strong.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>8</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46312</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_009&gt;</VoiceId>
      <JapaneseText>&lt;Chester&gt;さんには何度も助けられました</JapaneseText>
      <EnglishText>He's saved the rest of us a lot...</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>9</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46436</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_010&gt;</VoiceId>
      <JapaneseText>そっかー。&lt;Chester&gt;見てたらやる気になってきた。
オレもなんかやってやるぞ！</JapaneseText>
      <EnglishText>Huh... Y'know, watching him has made me wanna
practice some more, too! Alright, let's do it!</EnglishText>
      <Notes/>
      <SpeakerId>4</SpeakerId>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46500</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_011&gt;</VoiceId>
      <JapaneseText>クルール！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>46608</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_012&gt;</VoiceId>
      <JapaneseText>なんかって何するの。
もう&lt;Dio&gt;ったら！　待ってってば！</JapaneseText>
      <EnglishText>Wait, &lt;Dio&gt;, where are you
going? Hey, stop! Wait for me!</EnglishText>
      <Notes/>
      <SpeakerId>2</SpeakerId>
      <Id>12</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46688</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_013&gt;</VoiceId>
      <JapaneseText>あの子たちの今後が楽しみだね</JapaneseText>
      <EnglishText>Seems like these kids have a
bright future ahead of them.</EnglishText>
      <Notes/>
      <SpeakerId>5</SpeakerId>
      <Id>13</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>46756</PointerOffset>
      <VoiceId>&lt;audio:VCT_004_137_014&gt;</VoiceId>
      <JapaneseText>ええ、そうですね</JapaneseText>
      <EnglishText>Yes, it does.</EnglishText>
      <Notes/>
      <SpeakerId>6</SpeakerId>
      <Id>14</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
